@page "/admin/sender-lines"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject SenderLinesService Service
@inject ProvidersService Providers
@inject ProviderAccountsService Accounts
@inject CustomersService Customers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>خطوط ارسال | SmsHub</PageTitle>
<div class="admin-page-head"><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> خط ارسال جدید</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />

<section class="admin-data-panel"><header><div><h2>شماره‌های فرستنده</h2><span>خط اشتراکی مالک مشتری ندارد؛ خط اختصاصی می‌تواند به یک مشتری تعلق بگیرد.</span></div><div class="admin-table-search"><MudIcon Icon="@Icons.Material.Rounded.Search" /><input @bind="_filter" placeholder="جست‌وجوی شماره…" dir="ltr" /></div></header><div class="admin-table-wrap"><AdminGrid T="SenderLineItem" Items="@(FilteredItems)" Loading="_loading" Name="خطوط ارسال" ExportColumns='@(new AdminExportColumn<SenderLineItem>[] { new("خط", item => item.LineNumber), new("ارائه‌دهنده", item => ProviderName(item.ProviderId)), new("نوع مالکیت", item => item.IsSharedLine ? "اشتراکی" : "اختصاصی"), new("مشتری", item => CustomerName(item.CustomerId)), new("حساب اتصال", item => AccountName(item.ProviderAccountId)), new("مسیر ارسال", item => item.UseEsb ? "ESB" : "مستقیم"), new("وضعیت", item => item.IsActive ? "فعال" : "غیرفعال") })'><PropertyColumn Property="item => item.LineNumber" Title="خط"><CellTemplate><div class="mono"><b>@context.Item.LineNumber</b></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.ProviderId" Title="ارائه‌دهنده"><CellTemplate><div>@ProviderName(context.Item.ProviderId)</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.IsSharedLine" Title="نوع مالکیت"><CellTemplate><div><span class="admin-line-kind @(context.Item.IsSharedLine ? "shared" : "dedicated")">@(context.Item.IsSharedLine ? "اشتراکی" : "اختصاصی")</span></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.CustomerId" Title="مشتری"><CellTemplate><div>@CustomerName(context.Item.CustomerId)</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.ProviderAccountId" Title="حساب اتصال"><CellTemplate><div>@AccountName(context.Item.ProviderAccountId)</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.UseEsb" Title="مسیر ارسال"><CellTemplate><div>@(context.Item.UseEsb ? "ESB" : "مستقیم")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.IsActive" Title="وضعیت"><CellTemplate><div><StatusPill IsActive="context.Item.IsActive" /></div></CellTemplate></PropertyColumn>
<TemplateColumn Title="عملیات" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div class="admin-row-actions"><button title="ویرایش" @onclick="() => OpenEdit(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" title="حذف منطقی" @onclick="() => Delete(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></div></CellTemplate></TemplateColumn></AdminGrid></div></section>

@if (_editorOpen)
{
    <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor"><header><div><h2>@(_editingId is null ? "خط ارسال جدید" : "ویرایش خط ارسال")</h2><p>ارائه‌دهنده خط پس از ایجاد قابل تغییر نیست.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body">
        <label><span>ارائه‌دهنده</span><select @bind="_providerId" disabled="@(_editingId is not null)"><option value="0">انتخاب کنید</option>@foreach (ProviderItem provider in _providers.Where(item => item.IsActive)) { <option value="@provider.Id">@provider.Name</option> }</select></label>
        <label><span>شماره خط</span><input @bind="_lineNumber" dir="ltr" placeholder="30001234" /></label>
        <label class="admin-checkbox"><input type="checkbox" @bind="_isSharedLine" @bind:after="SharedLineChanged" /> خط بین مشتریان مشترک است</label>
        @if (!_isSharedLine)
        {
            <label><span>مشتری مالک (اختیاری)</span><select @bind="_customerId"><option value="">بدون مالک</option>@foreach (CustomerItem customer in _customers.Where(item => item.IsActive)) { <option value="@customer.Id">@customer.Name</option> }</select></label>
        }
        <label><span>حساب ارائه‌دهنده (اختیاری)</span><select @bind="_providerAccountId"><option value="">بدون حساب</option>@foreach (ProviderAccountItem account in MatchingAccounts) { <option value="@account.Id">@account.DisplayName</option> }</select><small>فقط حساب‌های فعال همان ارائه‌دهنده نمایش داده می‌شوند.</small></label>
        <label class="admin-checkbox"><input type="checkbox" @bind="_useEsb" /> ارسال از طریق ESB (ارائه‌دهنده 4040)</label><label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> خط فعال باشد</label>
    </div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">@(_saving ? "در حال ذخیره…" : "ذخیره")</button></footer></aside>
}

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private IReadOnlyList<SenderLineItem> _items = []; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<ProviderAccountItem> _accounts = []; private IReadOnlyList<CustomerItem> _customers = []; private short? _editingId; private byte _providerId; private string _lineNumber = string.Empty; private bool _isSharedLine = true; private short? _customerId; private int? _providerAccountId; private bool _isActive = true; private bool _useEsb; private string _filter = string.Empty; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success;
    private IReadOnlyList<SenderLineItem> FilteredItems => string.IsNullOrWhiteSpace(_filter) ? _items : _items.Where(item => item.LineNumber.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private IEnumerable<ProviderAccountItem> MatchingAccounts => _accounts.Where(item => item.ProviderId == _providerId && item.IsActive);
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; Task<UiResult<IReadOnlyList<SenderLineItem>>> linesTask = Service.List(_disposeToken.Token); Task<UiResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_disposeToken.Token); Task<UiResult<IReadOnlyList<ProviderAccountItem>>> accountsTask = Accounts.List(_disposeToken.Token); Task<UiResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_disposeToken.Token); await Task.WhenAll(linesTask, providersTask, accountsTask, customersTask); UiResult<IReadOnlyList<SenderLineItem>> lines = await linesTask; UiResult<IReadOnlyList<ProviderItem>> providers = await providersTask; UiResult<IReadOnlyList<ProviderAccountItem>> accounts = await accountsTask; UiResult<IReadOnlyList<CustomerItem>> customers = await customersTask; _items = lines.Value ?? []; _providers = providers.Value ?? []; _accounts = accounts.Value ?? []; _customers = customers.Value ?? []; _error = lines.ErrorMessage ?? providers.ErrorMessage ?? accounts.ErrorMessage ?? customers.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _providerId = 0; _lineNumber = string.Empty; _isSharedLine = true; _customerId = null; _providerAccountId = null; _isActive = true; _useEsb = false; _editorOpen = true; }
    private void OpenEdit(SenderLineItem item) { _editingId = item.Id; _providerId = item.ProviderId; _lineNumber = item.LineNumber; _isSharedLine = item.IsSharedLine; _customerId = item.CustomerId; _providerAccountId = item.ProviderAccountId; _isActive = item.IsActive; _useEsb = item.UseEsb; _editorOpen = true; }
    private void SharedLineChanged() { if (_isSharedLine) _customerId = null; }
    private void CloseEditor() => _editorOpen = false;
    private async Task Save() { if (_providerId == 0 || string.IsNullOrWhiteSpace(_lineNumber)) { _error = "ارائه‌دهنده و شماره خط الزامی است."; return; } if (_isSharedLine) _customerId = null; _saving = true; UiResult<string?> result; if (_editingId is null) { UiResult<CreateSenderLineResponse> create = await Service.Create(new CreateSenderLineRequest { ProviderId = _providerId, LineNumber = _lineNumber.Trim(), IsSharedLine = _isSharedLine, CustomerId = _customerId, ProviderAccountId = _providerAccountId, IsActive = _isActive, UseEsb = _useEsb }, _disposeToken.Token); result = create.IsSuccess ? UiResult<string?>.Success(null) : UiResult<string?>.Failure(create.ErrorMessage!); } else { result = await Service.Update(_editingId.Value, new UpdateSenderLineRequest { LineNumber = _lineNumber.Trim(), IsSharedLine = _isSharedLine, CustomerId = _customerId, ProviderAccountId = _providerAccountId, IsActive = _isActive, UseEsb = _useEsb }, _disposeToken.Token); } _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "خط ارسال ذخیره شد."; await Load(); }
    private async Task Delete(SenderLineItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"خط «{item.LineNumber}» حذف منطقی شود؟"); if (!confirmed) return; UiResult<string?> result = await Service.Delete(item.Id, _disposeToken.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = $"خط «{item.LineNumber}» حذف منطقی شد."; await Load(); }
    private string ProviderName(byte id) => _providers.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}";
    private string CustomerName(short? id) => id is null ? "—" : _customers.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}";
    private string AccountName(int? id) => id is null ? "—" : _accounts.FirstOrDefault(item => item.Id == id)?.DisplayName ?? $"#{id}";
    public void Dispose() { _disposeToken.Cancel(); _disposeToken.Dispose(); }
}
