@page "/admin/customers"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject CustomersService Service
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>مشتریان | SmsHub</PageTitle>

<div class="admin-page-head">
    <button class="admin-button primary" type="button" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> مشتری جدید</button>
</div>

<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />

<section class="admin-data-panel">
    <header><div><h2>فهرست مشتریان</h2><span>@PersianCount(_items.Count) مورد فعال و قابل مدیریت</span></div><div class="admin-table-search"><MudIcon Icon="@Icons.Material.Rounded.Search" /><input @bind="_filter" placeholder="جست‌وجوی نام یا کد…" /></div></header>
    <div class="admin-table-wrap">
        <AdminGrid T="CustomerItem" Items="@(FilteredItems)" Loading="_loading" Name="مشتریان" ExportColumns='@(new AdminExportColumn<CustomerItem>[] { new("شناسه", item => item.Id), new("نام مشتری", item => item.Name), new("کد ثابت", item => item.Code), new("وضعیت", item => item.IsActive ? "فعال" : "غیرفعال"), new("تاریخ ایجاد", item => item.CreatedAtUtc) })'><PropertyColumn Property="item => item.Id" Title="شناسه"><CellTemplate><div class="mono">@context.Item.Id</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Name" Title="نام مشتری"><CellTemplate><div><b>@context.Item.Name</b></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Code" Title="کد ثابت"><CellTemplate><div class="mono">@context.Item.Code</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.IsActive" Title="وضعیت"><CellTemplate><div><StatusPill IsActive="context.Item.IsActive" /></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.CreatedAtUtc" Title="تاریخ ایجاد"><CellTemplate><div>@context.Item.CreatedAtUtc.ToString("yyyy/MM/dd")</div></CellTemplate></PropertyColumn>
<TemplateColumn Title="کلیدهای API" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div><a class="admin-customer-keys" href="/admin/api-keys?customerId=@context.Item.Id" aria-label="@($"کلیدهای API مشتری {context.Item.Name}")"><MudIcon Icon="@Icons.Material.Rounded.VpnKey" /> کلیدهای API</a></div></CellTemplate></TemplateColumn>
<TemplateColumn Title="عملیات" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div class="admin-row-actions"><button title="ویرایش" @onclick="() => OpenEdit(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" title="حذف منطقی" @onclick="() => Delete(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></div></CellTemplate></TemplateColumn></AdminGrid>
    </div>
</section>

@if (_editorOpen)
{
    <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div>
    <aside class="admin-editor" aria-label="فرم مشتری">
        <header><div><h2>@(_editingId is null ? "مشتری جدید" : "ویرایش مشتری")</h2><p>نام نمایشی و کد یکتای مشتری را وارد کنید.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header>
        <div class="admin-editor-body">
            <label><span>نام مشتری</span><input @bind="_name" placeholder="مثلاً شرکت آب منطقه‌ای" /></label>
            <label><span>کد مشتری</span><input @bind="_code" dir="ltr" placeholder="water-company" disabled="@(_editingId is not null)" /><small>کد حذف‌شده دوباره قابل استفاده نیست.</small></label>
            @if (_editingId is not null) { <label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> مشتری فعال باشد</label> }
        </div>
        <footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">@(_saving ? "در حال ذخیره…" : "ذخیره")</button></footer>
    </aside>
}

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private IReadOnlyList<CustomerItem> _items = [];
    private bool _loading = true;
    private bool _saving;
    private bool _editorOpen;
    private short? _editingId;
    private string _name = string.Empty;
    private string _code = string.Empty;
    private bool _isActive = true;
    private string _filter = string.Empty;
    private string? _error;
    private string? _success;

    private IReadOnlyList<CustomerItem> FilteredItems => string.IsNullOrWhiteSpace(_filter) ? _items : _items.Where(item => item.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || item.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; UiResult<IReadOnlyList<CustomerItem>> result = await Service.List(_disposeToken.Token); _items = result.Value ?? []; _error = result.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _name = string.Empty; _code = string.Empty; _isActive = true; _editorOpen = true; }
    private void OpenEdit(CustomerItem item) { _editingId = item.Id; _name = item.Name; _code = item.Code; _isActive = item.IsActive; _editorOpen = true; }
    private void CloseEditor() => _editorOpen = false;
    private async Task Save() { if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_code)) { _error = "نام و کد مشتری الزامی است."; return; } _saving = true; UiResult<string?> result; if (_editingId is null) { UiResult<CreateCustomerResponse> create = await Service.Create(new CreateCustomerRequest { Name = _name.Trim(), Code = _code.Trim() }, _disposeToken.Token); result = create.IsSuccess ? UiResult<string?>.Success(null) : UiResult<string?>.Failure(create.ErrorMessage!); } else { result = await Service.Update(_editingId.Value, new UpdateCustomerRequest { Name = _name.Trim(), Code = _code.Trim(), IsActive = _isActive }, _disposeToken.Token); } _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "اطلاعات مشتری ذخیره شد."; await Load(); }
    private async Task Delete(CustomerItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"مشتری «{item.Name}» حذف منطقی شود؟"); if (!confirmed) return; UiResult<string?> result = await Service.Delete(item.Id, _disposeToken.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = $"مشتری «{item.Name}» به‌صورت منطقی حذف شد."; await Load(); }
    private static string PersianCount(int value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"));
    public void Dispose() { _disposeToken.Cancel(); _disposeToken.Dispose(); }
}
