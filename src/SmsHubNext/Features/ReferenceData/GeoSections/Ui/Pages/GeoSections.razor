@page "/admin/geo-sections"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject GeoSectionsService Service
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>مناطق جغرافیایی | SmsHub</PageTitle>
<div class="admin-page-head"><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> بخش جدید</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
<section class="admin-data-panel"><header><div><h2>درخت جغرافیایی</h2><span>والد، نوع بخش و مسیر پس از ایجاد تغییر نمی‌کنند.</span></div></header><div class="admin-table-wrap"><AdminGrid T="GeoSectionItem" Items="@(OrderedItems)" Loading="_loading" Name="مناطق جغرافیایی" ExportColumns='@(new AdminExportColumn<GeoSectionItem>[] { new("عنوان", item => item.Name), new("نوع", item => TypeLabel(item.SectionType)), new("کد", item => item.Code), new("مسیر", item => item.Path), new("وضعیت", item => item.IsActive ? "فعال" : "غیرفعال") })'><PropertyColumn Property="item => item.Name" Title="عنوان"><CellTemplate><div><span class="geo-name" style="padding-inline-start:@($"{Depth(context.Item) * 20}px")"><i></i><b>@context.Item.Name</b></span></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.SectionType" Title="نوع"><CellTemplate><div>@TypeLabel(context.Item.SectionType)</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Code" Title="کد"><CellTemplate><div class="mono">@context.Item.Code</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Path" Title="مسیر"><CellTemplate><div class="mono">@context.Item.Path</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.IsActive" Title="وضعیت"><CellTemplate><div><StatusPill IsActive="context.Item.IsActive" /></div></CellTemplate></PropertyColumn>
<TemplateColumn Title="عملیات" Sortable="false" Filterable="false" Hideable="false"><CellTemplate><div class="admin-row-actions"><button @onclick="() => OpenEdit(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" @onclick="() => Delete(context.Item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></div></CellTemplate></TemplateColumn></AdminGrid></div></section>
@if (_editorOpen) { <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor geo-editor" role="dialog" aria-modal="true" aria-labelledby="geo-editor-title"><header><div><h2 id="geo-editor-title">@(_editingId is null ? "بخش جغرافیایی جدید" : "ویرایش بخش")</h2><p>ترتیب مجاز: استان، شهر و سپس منطقه.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body">
@if (_error is not null) { <div class="geo-editor-error" role="alert">@_error</div> }
@if (_editingId is null) { <label><span>نوع بخش</span><select aria-label="نوع بخش" @bind="_sectionType" @bind:after="TypeChanged"><option value="@GeoSectionType.Province">استان</option><option value="@GeoSectionType.City">شهر</option><option value="@GeoSectionType.Zone">منطقه</option></select></label>@if (_sectionType != GeoSectionType.Province) { <label><span>والد</span><select aria-label="والد" @bind="_parentId"><option value="">انتخاب کنید</option>@foreach (GeoSectionItem parent in ValidParents) { <option value="@parent.Id">@parent.Name — @parent.Path</option> }</select></label> } }
<label><span>عنوان</span><input @bind="_name" /></label><label><span>کد ثابت</span><input @bind="_code" dir="ltr" /></label>@if (_editingId is not null) { <label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> فعال باشد</label> }
</div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">ذخیره</button></footer></aside> }
@code {
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<GeoSectionItem> _items = []; private int? _editingId; private int? _parentId; private GeoSectionType _sectionType = GeoSectionType.Province; private string _name = string.Empty; private string _code = string.Empty; private bool _isActive = true; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success;
    private IEnumerable<GeoSectionItem> OrderedItems => _items.OrderBy(item => item.Path); private IEnumerable<GeoSectionItem> ValidParents => _items.Where(item => item.IsActive && item.SectionType == (_sectionType == GeoSectionType.City ? GeoSectionType.Province : GeoSectionType.City));
    protected override Task OnInitializedAsync() => Load(); private async Task Load() { _loading = true; _error = null; UiResult<IReadOnlyList<GeoSectionItem>> result = await Service.List(_token.Token); _items = result.Value ?? []; _error = result.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _parentId = null; _sectionType = GeoSectionType.Province; _name = string.Empty; _code = string.Empty; _isActive = true; _error = null; _editorOpen = true; } private void OpenEdit(GeoSectionItem item) { _editingId = item.Id; _parentId = item.ParentGeoSectionId; _sectionType = item.SectionType; _name = item.Name; _code = item.Code; _isActive = item.IsActive; _error = null; _editorOpen = true; } private void CloseEditor() => _editorOpen = false; private void TypeChanged() => _parentId = null;
    private async Task Save() { if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_code) || (_sectionType != GeoSectionType.Province && _parentId is null)) { _error = "عنوان، کد و والد معتبر الزامی است."; return; } _saving = true; UiResult<string?> result; if (_editingId is null) { UiResult<CreateGeoSectionResponse> create = await Service.Create(new CreateGeoSectionRequest { ParentGeoSectionId = _parentId, SectionType = _sectionType, Name = _name.Trim(), Code = _code.Trim() }, _token.Token); result = create.IsSuccess ? UiResult<string?>.Success(null) : UiResult<string?>.Failure(create.ErrorMessage!); } else result = await Service.Update(_editingId.Value, new UpdateGeoSectionRequest { Name = _name.Trim(), Code = _code.Trim(), IsActive = _isActive }, _token.Token); _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "بخش جغرافیایی ذخیره شد."; await Load(); }
    private async Task Delete(GeoSectionItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"بخش «{item.Name}» حذف منطقی شود؟ بخش دارای فرزند قابل حذف نیست."); if (!confirmed) return; UiResult<string?> result = await Service.Delete(item.Id, _token.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = $"بخش «{item.Name}» حذف شد."; await Load(); }
    private int Depth(GeoSectionItem item) => item.SectionType switch { GeoSectionType.Province => 0, GeoSectionType.City => 1, _ => 2 }; private static string TypeLabel(GeoSectionType type) => type switch { GeoSectionType.Province => "استان", GeoSectionType.City => "شهر", _ => "منطقه" }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
