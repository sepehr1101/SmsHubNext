@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>ورود به پنل | SmsHub</PageTitle>

<section class="login-page">
    <div class="login-form-side">
        <a class="login-brand" href="/" aria-label="صفحه اصلی SmsHub">
            <span class="login-brand-mark">S</span>
            <span dir="ltr">SMS<span>Hub</span><small>NEXT</small></span>
        </a>

        <div class="login-card">
            <div class="login-heading">
                <h1>ورود به پنل مدیریت</h1>
            </div>

            @if (Error == "invalid_credentials")
            {
                <div class="login-alert" role="alert">
                    <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" />
                    نام کاربری یا رمز عبور درست نیست.
                </div>
            }


            <form class="login-form" method="post" action="/auth/login" data-enhance="false">
                <AntiforgeryToken />
                <label for="username">نام کاربری</label>
                <div class="login-input-wrap">
                    <svg class="login-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
                    <input id="username" name="username" type="text" value="Admin" autocomplete="username" required autofocus />
                </div>

                <label for="password">رمز عبور</label>
                <div class="login-input-wrap">
                    <svg class="login-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
                    <input id="password" name="password" type="@(_showPassword ? "text" : "password")" value="123456" autocomplete="current-password" required />
                    <button class="login-password-toggle" type="button" aria-label="نمایش یا مخفی کردن رمز عبور" @onclick="TogglePassword">
                        <svg class="login-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (_showPassword) { <path d="m3 3 18 18"/> }</svg>
                    </button>
                </div>

                <label class="login-remember">
                    <input name="remember" type="checkbox" />
                    <span>ورود من را به خاطر بسپار</span>
                </label>

                <button class="login-submit" type="submit">
                    ورود به پنل
                    <svg class="login-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>
                </button>
            </form>

            <a class="login-back" href="/">
                <svg class="login-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                بازگشت به صفحه اصلی
            </a>
        </div>
    </div>

