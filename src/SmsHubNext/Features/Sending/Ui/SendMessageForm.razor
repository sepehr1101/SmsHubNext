@inject SendingService Service
@inject CustomersService Customers
@inject SenderLinesService SenderLines
@inject MessageTypesService MessageTypes
@inject GeoSectionsService GeoSections
@inject ProvidersService Providers
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(ExcelMode ? "ارسال از اکسل | SmsHub" : "ارسال پیامک | SmsHub")</PageTitle>
<div @ref="_formRoot">
<ol class="ux-steps" aria-label="مراحل ارسال"><li aria-current="@(!_reviewing && _sentBatchId is null ? "step" : null)">۱. ورود پیام‌ها</li><li aria-current="@(_reviewing && _sentBatchId is null ? "step" : null)">۲. بازبینی و تأیید</li><li aria-current="@(_sentBatchId is not null ? "step" : null)">۳. پیگیری نتیجه</li></ol>
<FeatureNotice Loading="_loading" Error="@(_loadFailed || _messages.Count == 0 ? _error : null)" Success="@_success" OnRetry="@(_loadFailed ? EventCallback.Factory.Create(this, Load) : default)" />
@if (_sentBatchId is not null)
{
    <section class="send-result" role="status"><div><h2>ارسال #@PersianDisplay.Number(_sentBatchId) ثبت شد</h2><p>@PersianDisplay.Number(_acceptedCount) پیام در صف پردازش قرار گرفت. نتیجه ارسال و تحویل را در صفحه پیگیری ببینید.</p></div><button class="admin-button primary" @onclick="OpenBatch">پیگیری نتیجه ارسال</button><button class="admin-button secondary" @onclick="StartNew">ارسال جدید</button></section>
}
else
{
<NavigationLock ConfirmExternalNavigation="@(_messages.Any(item => item.Text.Length > 0 || item.Recipient.Length > 0))" OnBeforeInternalNavigation="ConfirmNavigation" />
@if (_reviewing)
{
    <section class="ux-guidance" tabindex="-1" @ref="_reviewHeading"><h2>بازبینی پیش از ارسال</h2><p>مشتری: <b>@_customers.FirstOrDefault(item => item.Id == _customerId)?.Name</b> · خط ارسال: <b dir="ltr">@_lines.FirstOrDefault(item => item.Id == _senderLineId)?.LineNumber</b> · نوع پیام: @_types.FirstOrDefault(item => item.Id == _messageTypeId)?.Name</p><p>گیرندگان و متن‌ها را بررسی کنید. ثبت نهایی با تأیید شما انجام می‌شود؛ هزینه نهایی با تعرفه معتبر هنگام ثبت محاسبه خواهد شد.</p></section>
}
<fieldset class="ux-fieldset" disabled="@(_loading || _quoting || _sending || _reviewing)">
@if (!ExcelMode) { <div class="admin-page-head"><button type="button" class="admin-button secondary" disabled="@(_messages.Count >= 1000)" @onclick="AddMessage"><MudIcon Icon="@Icons.Material.Rounded.Add" /> افزودن گیرنده</button></div> }
<section class="send-config">
<label><span>مشتری پرداخت‌کننده هزینه</span><select @bind="_customerId" @bind:after="CustomerChanged" aria-invalid="@FieldInvalid("customer")" aria-describedby="customer-error"><option value="0">انتخاب کنید</option>@foreach (CustomerItem customer in _customers.Where(item => item.IsActive)) { <option value="@customer.Id">@customer.Name</option> }</select><small id="customer-error" class="ux-field-error">@FieldError("customer")</small></label>
<label><span>خط ارسال</span><select @bind="_senderLineId" @bind:after="InvalidateReview" aria-invalid="@FieldInvalid("line")" aria-describedby="line-error"><option value="0">انتخاب کنید</option>@foreach (SenderLineItem line in AvailableLines) { <option value="@line.Id">@line.LineNumber — @ProviderName(line.ProviderId)</option> }</select><small id="line-error" class="ux-field-error">@FieldError("line")</small></label>
<label><span>نوع پیام</span><select @bind="_messageTypeId" @bind:after="InvalidateReview" aria-invalid="@FieldInvalid("type")" aria-describedby="type-error"><option value="0">انتخاب کنید</option>@foreach (MessageTypeItem type in _types.Where(item => item.IsActive)) { <option value="@type.Id">@type.Name</option> }</select><small id="type-error" class="ux-field-error">@FieldError("type")</small></label>
<details><summary>تنظیمات پیشرفته</summary><label><span>شناسه یکتای دسته</span><input @bind="_clientBatchId" @bind:after="InvalidateReview" dir="ltr" maxlength="100" aria-invalid="@FieldInvalid("batch")" /><small class="ux-field-error">@FieldError("batch")</small></label></details>
</section>
@if (ExcelMode) { <ExcelUpload OnImport="ImportMessages" Disabled="@(_sending || _quoting || _reviewing)" BusyChanged="SetImportBusy" /> }
@if (ExcelMode && _messages.Count > ExcelPreviewLimit) { <p role="status">پیش‌نمایش @PersianDisplay.Number(ExcelPreviewLimit) پیام نخست از مجموع @PersianDisplay.Number(_messages.Count, "N0") پیام؛ این محدودیت فقط مربوط به نمایش است.</p> }
<section class="send-editor-list">
@for (int index = 0; index < PreviewCount; index++)
{
    int itemIndex = index;
    SendMessageDraft item = _messages[index];
    string recipientKey = $"recipient-{index}";
    string textKey = $"text-{index}";
    <article @key="item"><header><b>پیام @PersianDisplay.Number(index + 1)</b><MudTooltip Text="حذف این گیرنده" ShowOnFocus="true"><button type="button" aria-label="@($"حذف پیام {PersianDisplay.Number(itemIndex + 1)}")" disabled="@(_messages.Count == 1 && !ExcelMode)" @onclick="() => RemoveMessage(itemIndex)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></MudTooltip></header>
    <div class="send-message-grid">
        <label><span>شماره گیرنده</span><input @bind="item.Recipient" @bind:event="oninput" @bind:after="InvalidateReview" dir="ltr" maxlength="12" placeholder="09121234567" aria-invalid="@FieldInvalid(recipientKey)" aria-describedby="@(recipientKey + "-error")" /><small id="@(recipientKey + "-error")" class="ux-field-error">@FieldError(recipientKey)</small></label>
        <label><span>منطقه جغرافیایی</span><select @bind="item.GeoSectionId" @bind:after="InvalidateReview"><option value="">بدون منطقه</option>@foreach (GeoSectionItem geo in _geoSections.Where(section => section.IsActive)) { <option value="@geo.Id">@GeoLabel(geo)</option> }</select></label>
        <label class="send-text"><span>متن پیام</span><textarea @bind="item.Text" @bind:event="oninput" @bind:after="InvalidateReview" maxlength="1800" placeholder="متن مستقل این گیرنده..." aria-invalid="@FieldInvalid(textKey)" aria-describedby="@(textKey + "-error")"></textarea><small>@PersianDisplay.Number(item.Text.Length, "N0") نویسه</small><small id="@(textKey + "-error")" class="ux-field-error">@FieldError(textKey)</small></label>
        <details><summary>اطلاعات تکمیلی</summary><div><label><span>شناسه همبستگی</span><input @bind="item.ClientCorrelatedId" @bind:after="InvalidateReview" dir="ltr" maxlength="100" /></label><label><span>شناسه قبض</span><input @bind="item.BillId" @bind:after="InvalidateReview" dir="ltr" maxlength="31" /></label><label><span>شناسه پرداخت</span><input @bind="item.PayId" @bind:after="InvalidateReview" dir="ltr" maxlength="31" /></label></div></details>
    </div></article>
}
</section>
</fieldset>
@if (_messages.Count > 0)
{
    <aside class="send-summary" aria-live="polite"><div><span>تعداد گیرنده</span><b>@PersianDisplay.Number(_messages.Count, "N0")</b></div><div><span>مجموع قطعه</span><b>@(_quotes is null ? "—" : PersianDisplay.Number(_quotes.Sum(item => item.SegmentCount), "N0"))</b></div><div><span>هزینه برآوردی</span><b>@(_quotes is null ? "پس از بازبینی محاسبه می‌شود" : PersianDisplay.Number(_quotes.Sum(item => item.TotalCost), "#,0.####") + " ریال")</b></div>
    @if (_reviewing) { <button type="button" class="admin-button secondary" disabled="@_sending" @onclick="InvalidateReview">ویرایش پیام‌ها</button><button type="button" class="admin-button primary" disabled="@_sending" @onclick="Send">@(_sending ? "در حال ثبت…" : "تأیید هزینه و ارسال")</button> }
    else { <button type="button" class="admin-button primary" disabled="@(_loading || _quoting || _importing)" @onclick="QuoteAll">@(_quoting ? "در حال محاسبه هزینه…" : "ادامه و بازبینی هزینه")</button> }
    @if (!_loadFailed && !string.IsNullOrEmpty(_error)) { <p class="send-submit-error" role="alert">@_error</p> }
    </aside>
}
}
</div>

@code {
    [Parameter] public bool ExcelMode { get; set; }
    private const int ExcelPreviewLimit = 20;
    private int PreviewCount => ExcelMode ? Math.Min(_messages.Count, ExcelPreviewLimit) : _messages.Count;
    private readonly CancellationTokenSource _token = new();
    private IReadOnlyList<SenderLineItem> _lines = [];
    private IReadOnlyList<MessageTypeItem> _types = [];
    private IReadOnlyList<GeoSectionItem> _geoSections = [];
    private IReadOnlyList<ProviderItem> _providers = [];
    private readonly List<SendMessageDraft> _messages = [new()];
    private List<CostQuote>? _quotes;
    private short _senderLineId;
    private short _customerId;
    private IReadOnlyList<CustomerItem> _customers = [];
    private IEnumerable<SenderLineItem> AvailableLines => _lines.Where(item => item.IsActive &&
        (item.UseEsb || item.ProviderAccountId is not null) &&
        (item.IsSharedLine || item.CustomerId is null || item.CustomerId == _customerId));
    private void CustomerChanged()
    {
        if (!AvailableLines.Any(item => item.Id == _senderLineId))
            _senderLineId = AvailableLines.FirstOrDefault()?.Id ?? (short)0;
        InvalidateReview();
    }
    private byte _messageTypeId;
    private string _clientBatchId = string.Empty;
    private long? _sentBatchId;
    private int _acceptedCount;
    private bool _loading = true, _loadFailed, _quoting, _sending, _importing, _reviewing;
    private string? _error, _success;
    private Dictionary<string, string> _fieldErrors = new();
    private ElementReference _formRoot, _reviewHeading;
    private bool _focusErrors, _focusReview;
    protected override Task OnInitializedAsync()
    {
        if (ExcelMode) _messages.Clear();
        return Load();
    }
    private async Task Load()
    {
        _loading = true;
        _error = null;
        Task<UiResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_token.Token);
        Task<UiResult<IReadOnlyList<SenderLineItem>>> linesTask = SenderLines.List(_token.Token);
        Task<UiResult<IReadOnlyList<MessageTypeItem>>> typesTask = MessageTypes.List(_token.Token);
        Task<UiResult<IReadOnlyList<GeoSectionItem>>> geoTask = GeoSections.List(_token.Token);
        Task<UiResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token);
        await Task.WhenAll(customersTask, linesTask, typesTask, geoTask, providersTask);
        UiResult<IReadOnlyList<CustomerItem>> customers = await customersTask;
        UiResult<IReadOnlyList<SenderLineItem>> lines = await linesTask;
        UiResult<IReadOnlyList<MessageTypeItem>> types = await typesTask;
        UiResult<IReadOnlyList<GeoSectionItem>> geo = await geoTask;
        UiResult<IReadOnlyList<ProviderItem>> providers = await providersTask;
        _customers = customers.Value ?? [];
        _lines = lines.Value ?? [];
        _types = types.Value ?? [];
        _geoSections = geo.Value ?? [];
        _providers = providers.Value ?? [];
        CustomerItem[] activeCustomers = _customers.Where(item => item.IsActive).ToArray();
        _customerId = activeCustomers.Length == 1 ? activeCustomers[0].Id : (short)0;
        _senderLineId = AvailableLines.FirstOrDefault()?.Id ?? (short)0;
        _messageTypeId = _types.FirstOrDefault(item => item.IsActive)?.Id ?? (byte)0;
        if (string.IsNullOrEmpty(_clientBatchId)) _clientBatchId = $"ui-{Guid.NewGuid():N}";
        _error = customers.ErrorMessage ?? lines.ErrorMessage ?? types.ErrorMessage ?? geo.ErrorMessage ?? providers.ErrorMessage;
        _loadFailed = _error is not null;
        _loading = false;
    }
    private void SetImportBusy(bool busy) => _importing = busy;
    private void ImportMessages(List<SendMessageDraft> messages)
    {
        _messages.Clear();
        _messages.AddRange(messages);
        InvalidateReview();
        _clientBatchId = $"ui-{Guid.NewGuid():N}";
        _success = $"{PersianDisplay.Number(messages.Count)} پیام از اکسل ساخته شد؛ پیش از ارسال متن‌ها و شماره‌ها را بررسی کنید.";
    }
    private void AddMessage() { if (_messages.Count < 1000) _messages.Add(new()); InvalidateReview(); }
    private void RemoveMessage(int index) { if (_messages.Count > 1 || ExcelMode) _messages.RemoveAt(index); InvalidateReview(); }
    private void InvalidateReview()
    {
        _quotes = null;
        _reviewing = false;
        _error = _success = null;
        _fieldErrors.Clear();
    }
    private async Task QuoteAll()
    {
        if (_quoting || _sending || _loading || _importing || !Validate()) return;
        SenderLineItem? line = _lines.FirstOrDefault(item => item.Id == _senderLineId);
        if (line is null) return;
        _quoting = true;
        _error = _success = null;
        _quotes = null;
        try
        {
            List<CostQuote> quotes = [];
            foreach (SendMessageDraft message in _messages)
            {
                UiResult<CostQuote> result = await Service.Quote(new QuoteRequest { ProviderId = line.ProviderId, MessageTypeId = _messageTypeId, Text = message.Text.Trim() }, _token.Token);
                if (!result.IsSuccess || result.Value is null) { _error = result.ErrorMessage; return; }
                quotes.Add(result.Value);
            }
            _quotes = quotes;
            _reviewing = true;
            _focusReview = true;
        }
        finally { _quoting = false; }
    }
    private async Task Send()
    {
        if (_sending || !_reviewing || _quotes is null || _sentBatchId is not null || !Validate()) return;
        SenderLineItem line = _lines.First(item => item.Id == _senderLineId);
        List<SendMessageItem> messages = _messages.Select(item => new SendMessageItem
        {
            Recipient = PersianDisplay.SearchText(item.Recipient), Text = item.Text.Trim(),
            ClientCorrelatedId = Clean(item.ClientCorrelatedId), BillId = Clean(item.BillId), PayId = Clean(item.PayId), GeoSectionId = item.GeoSectionId,
        }).ToList();
        _sending = true;
        try
        {
            UiResult<SendMessagesResponse> result = await Service.Send(new SendMessagesRequest
            {
                SenderLine = line.LineNumber, MessageTypeId = _messageTypeId,
                ClientBatchId = _clientBatchId.Trim(), Messages = messages,
            }, _customerId, _token.Token);
            if (!result.IsSuccess || result.Value is null) { _error = result.ErrorMessage; return; }
            _sentBatchId = result.Value.BatchId;
            _acceptedCount = result.Value.AcceptedCount;
            _error = null;
        }
        finally { _sending = false; }
    }
    private bool Validate()
    {
        _error = null;
        _fieldErrors = SendDraftValidation.Errors(_messages, _senderLineId, _messageTypeId, _clientBatchId);
        if (!_customers.Any(item => item.Id == _customerId && item.IsActive))
            _fieldErrors["customer"] = "مشتری پرداخت‌کننده هزینه را انتخاب کنید.";
        if (!AvailableLines.Any(item => item.Id == _senderLineId))
            _fieldErrors["line"] = "خط مجاز برای این مشتری را انتخاب کنید.";
        if (_fieldErrors.Count == 0) return true;
        _error = string.Join(" ", _fieldErrors.Values.Take(3));
        _focusErrors = true;
        return false;
    }
    private string? FieldError(string key) => _fieldErrors.GetValueOrDefault(key);
    private string FieldInvalid(string key) => _fieldErrors.ContainsKey(key) ? "true" : "false";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusErrors) { _focusErrors = false; await JS.InvokeVoidAsync("adminForms.focusInvalid", _formRoot); }
        if (_focusReview) { _focusReview = false; await _reviewHeading.FocusAsync(); }
    }
    private async Task ConfirmNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (_sentBatchId is not null || !_messages.Any(item => item.Text.Length > 0 || item.Recipient.Length > 0)) return;
        if (!await JS.InvokeAsync<bool>("confirm", "پیام‌های این فرم هنوز ثبت نشده‌اند. از صفحه خارج می‌شوید؟")) context.PreventNavigation();
    }
    private void StartNew()
    {
        _sentBatchId = null;
        _messages.Clear();
        if (!ExcelMode) _messages.Add(new());
        _clientBatchId = $"ui-{Guid.NewGuid():N}";
        InvalidateReview();
    }
    private void OpenBatch() { if (_sentBatchId is not null) Navigation.NavigateTo($"/admin/dispatch-operations/{_sentBatchId}"); }
    private string ProviderName(byte id) => _providers.FirstOrDefault(item => item.Id == id)?.Name ?? id.ToString();
    private static string GeoLabel(GeoSectionItem item) => $"{new string('—', (int)item.SectionType - 1)} {item.Name}";
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
