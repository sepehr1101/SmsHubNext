@page "/admin/dispatch-operations"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject DispatchOperationsService Service
@implements IDisposable

<PageTitle>پایش ارسال | SmsHub</PageTitle>
<div class="admin-page-head"><div class="admin-page-actions"><label class="problem-toggle"><input type="checkbox" @bind="_onlyProblems" @bind:after="Reload" /><span>فقط موارد مشکل‌دار</span></label><button class="admin-button secondary" @onclick="Reload"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> تازه‌سازی</button></div></div>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Reload" />
@if (_summary is not null) { <section class="dispatch-kpis"><article><span>دسته‌ها</span><b>@_summary.Totals.BatchCount.ToString("N0")</b><small>@_summary.Totals.MessageCount.ToString("N0") پیام</small></article><article class="warn"><span>نگه‌داشته‌شده</span><b>@_summary.Totals.HeldBatchCount</b><small>نیازمند بررسی اعتبار</small></article><article class="danger"><span>شکست ارسال</span><b>@_summary.Totals.DispatchFailedBatchCount</b><small>بیشینه تلاش: @_summary.Totals.MaxDispatchAttemptCount</small></article><article><span>هزینه صف</span><b>@_summary.Totals.TotalCost.ToString("N0")</b><small>ریال</small></article></section> }
<section class="admin-data-panel"><header><div><h2>دسته‌های ارسال</h2><span>@(_page?.TotalCount.ToString("N0") ?? "۰") دسته مطابق فیلتر</span></div></header><div class="admin-table-wrap"><AdminGrid T="DispatchOperationsBatchRow" Items="@(_page?.Items ?? [])" Loading="_loading" Name="دسته‌های ارسال" PageLocal="true" ExportColumns='@(new AdminExportColumn<DispatchOperationsBatchRow>[] { new("شناسه", item => item.Id), new("تاریخ جلالی", item => item.SubmitDateJalali), new("ارائه‌دهنده", item => item.ProviderName), new("پیام/قطعه", item => $"{item.MessageCount} / {item.SegmentCount}"), new("هزینه", item => item.TotalCost), new("وضعیت", item => StatusLabel(item.Status)), new("تلاش", item => item.DispatchAttemptCount), new("آخرین رویداد", item => item.LastEventType is null ? "—" : EventLabel(item.LastEventType.Value)) })'><PropertyColumn Property="item => item.Id" Title="شناسه"><CellTemplate><div class="mono"><a class="table-link" href="/admin/dispatch-operations/@context.Item.Id">#@context.Item.Id</a></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.SubmitDateJalali" Title="تاریخ جلالی"><CellTemplate><div class="mono">@context.Item.SubmitDateJalali</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.ProviderName" Title="ارائه‌دهنده"><CellTemplate><div>@context.Item.ProviderName <small class="table-sub">@context.Item.ProviderCode</small></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.MessageCount" Title="پیام/قطعه"><CellTemplate><div>@context.Item.MessageCount / @context.Item.SegmentCount</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.TotalCost" Title="هزینه"><CellTemplate><div class="money">@context.Item.TotalCost.ToString("N0") ریال</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Status" Title="وضعیت"><CellTemplate><div><span class="batch-status status-@((byte)context.Item.Status)">@StatusLabel(context.Item.Status)</span>@if (context.Item.StatusReason is not null) { <small class="table-sub">@ReasonLabel(context.Item.StatusReason.Value)</small> }</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.DispatchAttemptCount" Title="تلاش"><CellTemplate><div>@context.Item.DispatchAttemptCount</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.LastEventType" Title="آخرین رویداد"><CellTemplate><div>@(context.Item.LastEventType is null ? "—" : EventLabel(context.Item.LastEventType.Value))<small class="table-sub">@(context.Item.LastEventTimeUtc?.ToString("HH:mm") ?? string.Empty)</small></div></CellTemplate></PropertyColumn></AdminGrid></div>@if ((_page?.TotalCount ?? 0) > PageSize) { <footer class="admin-pagination"><button disabled="@(_currentPage <= 1)" @onclick="PreviousPage">قبلی</button><span>صفحه @_currentPage</span><button disabled="@(_page is null || _currentPage * PageSize >= _page.TotalCount)" @onclick="NextPage">بعدی</button></footer> }</section>
@code {
    private const int PageSize = 25; private readonly CancellationTokenSource _token = new(); private DispatchOperationsSummary? _summary; private DispatchOperationsBatchPage? _page; private bool _onlyProblems; private int _currentPage = 1; private bool _loading = true; private string? _error;
    protected override Task OnInitializedAsync() => Reload(); private async Task Reload() { _currentPage = 1; await Load(); } private async Task Load() { _loading = true; _error = null; Task<UiResult<DispatchOperationsSummary>> summaryTask = Service.Summary(_onlyProblems, _token.Token); Task<UiResult<DispatchOperationsBatchPage>> pageTask = Service.Batches(_onlyProblems, _currentPage, PageSize, _token.Token); await Task.WhenAll(summaryTask, pageTask); UiResult<DispatchOperationsSummary> summary = await summaryTask; UiResult<DispatchOperationsBatchPage> page = await pageTask; _summary = summary.Value; _page = page.Value; _error = summary.ErrorMessage ?? page.ErrorMessage; _loading = false; }
    private async Task PreviousPage() { if (_currentPage > 1) { _currentPage--; await Load(); } } private async Task NextPage() { if (_page is not null && _currentPage * PageSize < _page.TotalCount) { _currentPage++; await Load(); } }
    private static string StatusLabel(BatchStatus status) => status switch { BatchStatus.Received=>"دریافت‌شده",BatchStatus.Dispatching=>"در حال ارسال",BatchStatus.DispatchCompleted=>"تکمیل",BatchStatus.DispatchPartiallyFailed=>"بخشی ناموفق",BatchStatus.Held=>"نگه‌داشته",BatchStatus.Rejected=>"ردشده",_=>"شکست ارسال" }; private static string ReasonLabel(BatchStatusReason reason) => reason switch { BatchStatusReason.InsufficientProviderCredit=>"کمبود اعتبار ارائه‌دهنده",BatchStatusReason.InsufficientCustomerBalance=>"کمبود اعتبار مشتری",BatchStatusReason.DispatchRetriesExhausted=>"اتمام تلاش‌ها",BatchStatusReason.InvalidProviderCredentials=>"اعتبارنامه نامعتبر",_=>"نیازمند بررسی" }; private static string EventLabel(MessageBatchEventType type) => type switch { MessageBatchEventType.Accepted=>"پذیرش",MessageBatchEventType.DispatchStarted=>"شروع ارسال",MessageBatchEventType.Held=>"توقف",MessageBatchEventType.DispatchCompleted=>"تکمیل",MessageBatchEventType.DispatchFailed=>"شکست",MessageBatchEventType.DispatchRetryRequested=>"درخواست تلاش مجدد",_=>"به‌روزرسانی" }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
