@page "/admin/dispatch-live"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@using SmsHubNext.Features.DispatchOperations
@using SmsHubNext.Features.Reports.Ui
@using SmsHubNext.Features.Reports.Ui.Pages
@inject LiveDispatchService Service
@inject IDialogService Dialogs
@implements IAsyncDisposable

<PageTitle>پایش زنده ارسال | SmsHub</PageTitle>
<div class="live-dispatch">
    <header class="live-heading"><h1>پایش زنده ارسال</h1><nav><a href="/admin/dispatch-operations">دسته‌های ارسال</a><a href="/admin/settings/errors">خطاهای نرم‌افزار</a></nav></header>
    <div class="live-connection" role="status"><span class="live-dot @(_error is null && _snapshot is not null ? "connected" : "")"></span><span>@(_error is null && _snapshot is not null ? "پایش زنده" : "در انتظار اتصال")</span><span>آخرین دریافت: @Time(_snapshot?.ObservedAtUtc)</span></div>
    <FeatureNotice Loading="_loading" Error="@_error" OnRetry="Refresh" />
    @if (_snapshot is { } snapshot)
    {
        <section class="report-summary" aria-label="وضعیت پیام‌های ۲۴ ساعت اخیر">
            <article><span>در صف</span><strong>@N(snapshot.Totals.Queued)</strong></article>
            <article><span>در حال ارسال / انتظار تأیید</span><strong>@N(snapshot.Totals.Unconfirmed)</strong></article>
            <article><span>پذیرش سرویس‌دهنده</span><strong>@N(snapshot.Totals.Accepted)</strong></article>
            <article><span>رد ارسال</span><strong>@N(snapshot.Totals.Rejected)</strong></article>
        </section>
        <div class="live-outcomes"><span>ارسال تأییدشده <b>@N(snapshot.Totals.Sent)</b></span><span>تحویل به گیرنده <b>@N(snapshot.Totals.Delivered)</b></span><span>تحویل‌نشده / منقضی <b>@N(snapshot.Totals.DeliveryFailed)</b></span>
            <MudTooltip Text="شمارنده‌ها برای پیام‌های دریافت‌شده در ۲۴ ساعت اخیرند و هر دقیقه تازه می‌شوند. پذیرش سرویس‌دهنده به معنی تحویل به گیرنده نیست." ShowOnFocus="true"><button type="button" class="live-info" aria-label="راهنمای شمارنده‌ها"><MudIcon Icon="@Icons.Material.Outlined.Info" /></button></MudTooltip>
        </div>
        <LiveAcceptanceChart Snapshot="snapshot" Disconnected="@(_error is not null)" />
    }
    <section class="admin-data-panel live-message-panel">
        <header class="live-table-heading"><h2>پیام‌ها</h2><span>@N(_request.Hours) ساعت اخیر</span></header>
        @if (_showFilters)
        {
            <form class="live-filters" @onsubmit="Apply" @onsubmit:preventDefault>
                <label>بازه دریافت<select @bind="_hours" disabled="@_loading"><option value="1">یک ساعت</option><option value="6">شش ساعت</option><option value="24">۲۴ ساعت</option></select></label>
                <label>وضعیت<select @bind="_status" disabled="@_loading"><option value="">همه</option><option value="1">در صف</option><option value="6">در حال ارسال / انتظار تأیید</option><option value="2">پذیرش سرویس‌دهنده</option><option value="3">ارسال تأییدشده</option><option value="4">رد ارسال</option><option value="5">نامشخص</option></select></label>
                <label>شناسه سرویس‌دهنده<input @bind="_provider" inputmode="numeric" disabled="@_loading" /></label>
                <label>شناسه دسته<input @bind="_batch" inputmode="numeric" disabled="@_loading" /></label>
                <button type="submit" class="live-apply" disabled="@_loading">اعمال فیلترها</button>
            </form>
        }
        <LiveMessagePager Page="_page" PageSize="_request.PageSize" Count="@(_messages?.Items.Count ?? 0)" HasMore="@(_messages?.HasMore == true)" Loading="_loading" First="First" Previous="Previous" Next="Next" SizeChanged="ChangeSize" />
        <div class="admin-table-wrap">
            <AdminGrid T="LiveMessage" Items="@(_messages?.Items ?? [])" Loading="_loading" PageLocal="true" PageSize="_request.PageSize" ShowSearch="false" EnableLocalOperations="false" OnFilter="ToggleFilters" Name="پایش پیام‌ها" ExportColumns="ExportColumns">
                <ToolbarContent>
                    <form class="live-search" @onsubmit="Apply" @onsubmit:preventDefault><input type="search" @bind="_search" @bind:event="oninput" placeholder="شماره گیرنده یا شناسه پیام" aria-label="جست‌وجوی شماره گیرنده یا شناسه پیام" maxlength="64" disabled="@_loading" /><MudTooltip Text="جست‌وجو در همه پیام‌های بازه" ShowOnFocus="true"><button type="submit" disabled="@_loading" aria-label="جست‌وجوی پیام"><MudIcon Icon="@Icons.Material.Rounded.Search" /></button></MudTooltip></form>
                </ToolbarContent>
                <ChildContent>
                    <PropertyColumn Property="item => item.Id" Title="پیام / دسته"><CellTemplate><div class="live-cell"><span class="live-message-id">پیام @N(context.Item.Id)</span><a class="live-batch-link" href="/admin/dispatch-operations/@context.Item.MessageBatchId" aria-label="@($"مشاهده دسته {N(context.Item.MessageBatchId)}")">دسته @N(context.Item.MessageBatchId)<MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" /></a></div></CellTemplate></PropertyColumn>
                    <PropertyColumn Property="item => item.MobileNumber" Title="گیرنده / خط / سرویس"><CellTemplate><div class="live-cell"><b dir="ltr">@PersianDisplay.Text(context.Item.MobileNumber)</b><span dir="ltr">@PersianDisplay.Text(context.Item.SenderLine)</span><small>@context.Item.ProviderName</small></div></CellTemplate></PropertyColumn>
                    <PropertyColumn Property="item => item.Status" Title="وضعیت ارسال / تحویل"><CellTemplate><div class="live-cell"><span>@MessageDiagnosticText.Send(context.Item.Status)</span><small>@MessageDiagnosticText.Delivery(context.Item.DeliveryStatus)</small></div></CellTemplate></PropertyColumn>
                    <PropertyColumn Property="item => item.SubmittedAtUtc" Title="دریافت / تأیید پذیرش"><CellTemplate><div class="live-cell live-times"><span>@Time(context.Item.SubmittedAtUtc)</span><small>@Time(context.Item.AcceptedAtUtc)</small></div></CellTemplate></PropertyColumn>
                    <PropertyColumn Property="item => item.DispatchAttemptCount" Title="تلاش دسته"><CellTemplate>@N(context.Item.DispatchAttemptCount)</CellTemplate></PropertyColumn>
                    <PropertyColumn Property="item => item.ErrorAtUtc" Title="سابقه خطای دسته"><CellTemplate>
                        @if (context.Item.ErrorEvent is MessageBatchEventType stage) { <MudTooltip Text="رویداد دسته؛ وضعیت فعلی این پیام در ستون ارسال / تحویل است." ShowOnFocus="true"><div class="live-cell live-error-history" tabindex="0"><span>@Time(context.Item.ErrorAtUtc)</span><span>@MessageDiagnosticText.BatchErrorHistory(stage)</span><small>کد ثبت‌شده دسته: @PersianDisplay.Number(context.Item.ErrorCode)</small></div></MudTooltip> }
                        else { <MudTooltip Text="خطایی برای این دسته ثبت نشده است" ShowOnFocus="true"><span class="live-no-error" tabindex="0" role="img" aria-label="خطایی برای این دسته ثبت نشده است"><MudIcon Icon="@Icons.Material.Rounded.CheckCircle" /></span></MudTooltip> }
                    </CellTemplate></PropertyColumn>
                    <TemplateColumn Title="متن / جزئیات" Sortable="false" Filterable="false"><CellTemplate><div class="live-cell live-details"><details><summary>@Preview(context.Item.Body)</summary><p class="live-body">@(context.Item.Body ?? "متن نگهداری نشده است")</p></details><button type="button" class="live-diagnostic-button" @onclick="() => OpenDiagnostics(context.Item.Id)"><MudIcon Icon="@Icons.Material.Rounded.ManageSearch" Size="Size.Small" />عیب‌یابی و خطاها</button></div></CellTemplate></TemplateColumn>
                </ChildContent>
            </AdminGrid>
        </div>
        <LiveMessagePager Page="_page" PageSize="_request.PageSize" Count="@(_messages?.Items.Count ?? 0)" HasMore="@(_messages?.HasMore == true)" Loading="_loading" First="First" Previous="Previous" Next="Next" SizeChanged="ChangeSize" />
    </section>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Stack<LiveMessageRequest> _history = new();
    private Task? _poll;
    private LiveSnapshot? _snapshot;
    private LiveMessagePage? _messages;
    private LiveMessageRequest _request = new();
    private bool _loading, _showFilters;
    private string? _error;
    private int _hours = 24, _page = 1;
    private string _search = "", _provider = "", _batch = "", _status = "";
    private static readonly AdminExportColumn<LiveMessage>[] ExportColumns =
    [
        new("پیام / دسته", item => $"{item.Id} / {item.MessageBatchId}"),
        new("گیرنده / خط / سرویس", item => $"{item.MobileNumber} / {item.SenderLine} / {item.ProviderName}"),
        new("وضعیت ارسال / تحویل", item => $"{MessageDiagnosticText.Send(item.Status)} / {MessageDiagnosticText.Delivery(item.DeliveryStatus)}"),
        new("دریافت / تأیید پذیرش", item => $"{Time(item.SubmittedAtUtc)} / {Time(item.AcceptedAtUtc)}"),
        new("تلاش دسته", item => item.DispatchAttemptCount),
        new("سابقه خطای دسته", item => item.ErrorEvent is MessageBatchEventType stage ? $"{Time(item.ErrorAtUtc)} / {MessageDiagnosticText.BatchErrorHistory(stage)} / {item.ErrorCode}" : "خطایی ثبت نشده است"),
        new("متن / جزئیات", item => item.Body),
    ];
    protected override async Task OnInitializedAsync() => await Refresh();
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) _poll = Poll(); return Task.CompletedTask; }
    private async Task Poll()
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(10));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private async Task Refresh()
    {
        if (_loading || _lifetime.IsCancellationRequested) return;
        _loading = true;
        try
        {
            UiResult<LiveSnapshot> summary = await Service.Summary(_lifetime.Token);
            if (summary.IsSuccess) _snapshot = summary.Value;
            // Preserve the time window and cursor while browsing older messages.
            await ReadMessages(_page == 1 ? _request with { UntilUtc = null } : _request, _page);
            _error = summary.ErrorMessage ?? _error;
        }
        finally { _loading = false; }
    }
    private async Task<bool> ReadMessages(LiveMessageRequest request, int page)
    {
        UiResult<LiveMessagePage> result = await Service.Messages(request, _lifetime.Token);
        _error = result.ErrorMessage;
        if (!result.IsSuccess) return false;
        LiveMessagePage messages = result.Value!;
        _messages = messages;
        _request = request with { UntilUtc = messages.UntilUtc };
        _page = page;
        return true;
    }
    private async Task<bool> Navigate(LiveMessageRequest request, int page)
    {
        if (_loading || _lifetime.IsCancellationRequested) return false;
        _loading = true;
        try { return await ReadMessages(request, page); }
        finally { _loading = false; }
    }
    private async Task Apply()
    {
        if (_loading) return;
        string provider = PersianDisplay.SearchText(_provider), batch = PersianDisplay.SearchText(_batch);
        if ((provider.Length > 0 && (!byte.TryParse(provider, out byte providerId) || providerId == 0)) || (batch.Length > 0 && (!long.TryParse(batch, out long batchId) || batchId <= 0))) { _error = "شناسه سرویس‌دهنده یا دسته معتبر نیست."; return; }
        LiveMessageRequest request = new()
        {
            Hours = _hours, Status = _status.Length == 0 ? null : byte.Parse(_status),
            Provider = provider.Length == 0 ? null : byte.Parse(provider), Batch = batch.Length == 0 ? null : long.Parse(batch),
            Search = _search, PageSize = _request.PageSize,
        };
        if (await Navigate(request, 1)) _history.Clear();
    }
    private async Task First() { if (await Navigate(_request with { Before = null, UntilUtc = null }, 1)) _history.Clear(); }
    private async Task Previous() { if (_history.Count > 0 && await Navigate(_history.Peek(), _page - 1)) _history.Pop(); }
    private async Task Next()
    {
        if (_messages?.NextCursor is not { } cursor) return;
        LiveMessageRequest previous = _request;
        if (await Navigate(_request with { Before = cursor }, _page + 1)) _history.Push(previous);
    }
    private async Task ChangeSize(int size) { if (await Navigate(_request with { PageSize = size, Before = null, UntilUtc = null }, 1)) _history.Clear(); }
    private void ToggleFilters() => _showFilters = !_showFilters;
    private async Task OpenDiagnostics(long id)
    {
        DialogParameters<MessageDiagnosticDialog> parameters = new() { { dialog => dialog.MessageId, id } };
        await Dialogs.ShowAsync<MessageDiagnosticDialog>($"عیب‌یابی پیام {N(id)}", parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseOnEscapeKey = true });
    }
    private static string N(long value) => PersianDisplay.Number(value);
    private static string Time(DateTime? value) => value is null ? "—" : PersianDisplay.Date(IranTime.FromUtc(new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc))), "yyyy/MM/dd HH:mm:ss");
    private static string Preview(string? body) => body is null ? "متن موجود نیست" : body.Length > 60 ? body[..60] + "…" : body;
    public async ValueTask DisposeAsync() { _lifetime.Cancel(); if (_poll is not null) await _poll; _lifetime.Dispose(); }
}
