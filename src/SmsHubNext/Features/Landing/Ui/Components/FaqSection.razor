@using SmsHubNext.Features.Landing
@using SmsHubNext.Shared.Results
@inject FaqHandler Handler

@if (_items.Count > 0)
{
    <section class="wrap section faq-section" id="faq">
        <div class="section-heading"><p class="eyebrow">پیش از شروع</p><h2>چند سؤال رایج</h2></div>
        @foreach (FaqItem item in _items)
        {
            <details @key="item.Id"><summary>@item.Question</summary><p style="white-space: pre-line">@item.Answer</p></details>
        }
    </section>
}

@code {
    private IReadOnlyList<FaqItem> _items = [];
    protected override async Task OnInitializedAsync()
    {
        Result<IReadOnlyList<FaqItem>> result = await Handler.List(CancellationToken.None);
        if (result.IsSuccess) _items = result.Value;
    }
}
