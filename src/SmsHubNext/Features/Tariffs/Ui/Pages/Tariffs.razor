@page "/admin/tariffs"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject TariffsService Service
@inject ProvidersService Providers
@inject MessageTypesService MessageTypes
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>تعرفه‌ها | SmsHub</PageTitle>
<div class="admin-page-head"><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> نسخه تعرفه جدید</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@SuccessMessage" OnRetry="Load" />
<div class="admin-rule-callout"><MudIcon Icon="@Icons.Material.Rounded.LockClock" /><p><b>محورهای قیمت و نرخ‌ها تغییرناپذیرند</b><span>برای تغییر قیمت، نسخه جدید بسازید. نسخه موجود فقط قابل بستن یا غیرفعال‌کردن است.</span></p></div>
<section class="admin-data-panel"><header><div><h2>نسخه‌های تعرفه</h2><span>واحد همه قیمت‌ها ریال ایران است.</span></div></header><div class="tariff-grid">
@if (!_loading && _items.Count == 0) { <div class="admin-empty">تعرفه‌ای ثبت نشده است.</div> }
@foreach (TariffItem item in _items.OrderByDescending(item => item.EffectiveFromUtc)) { <article class="tariff-card"><header><div><b>@ProviderName(item.ProviderId)</b><span>@EncodingLabel(item.Encoding) · @(item.MessageTypeId is null ? "همه انواع پیام" : MessageTypeName(item.MessageTypeId.Value))</span></div><StatusPill IsActive="item.IsActive" /></header><div class="tariff-period"><span>از <b>@DateLabel(item.EffectiveFromUtc)</b></span><span>تا <b>@(item.EffectiveToUtc is null ? "باز" : DateLabel(item.EffectiveToUtc.Value))</b></span></div><div class="tariff-rates">@foreach (TariffRateItem rate in item.Rates) { <div><span>@rate.MinChars تا @(rate.MaxChars?.ToString() ?? "∞") نویسه</span><b>@rate.PricePerSegment.ToString("N0") ریال / قطعه</b></div> }</div><footer><button @onclick="() => OpenEdit(item)"><MudIcon Icon="@Icons.Material.Rounded.EditCalendar" /> پایان/وضعیت</button><button class="danger" @onclick="() => Delete(item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /> حذف</button></footer></article> }
</div></section>
@if (_editorOpen) { <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor wide"><header><div><h2>@(_editingId is null ? "نسخه تعرفه جدید" : "مدیریت نسخه تعرفه")</h2><p>@(_editingId is null ? "بازه‌ها باید از نویسه ۱ پیوسته باشند و آخرین سقف خالی باشد." : "فقط پایان اعتبار و وضعیت قابل ویرایش‌اند.")</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body">
@if (_editingId is null) { <label><span>ارائه‌دهنده</span><select @bind="_providerId"><option value="0">انتخاب کنید</option>@foreach (ProviderItem provider in _providers.Where(item => item.IsActive)) { <option value="@provider.Id">@provider.Name</option> }</select></label><label><span>نوع پیام (اختیاری)</span><select @bind="_messageTypeId"><option value="">همه انواع پیام</option>@foreach (MessageTypeItem type in _messageTypes.Where(item => item.IsActive)) { <option value="@type.Id">@type.Name</option> }</select></label><label><span>کدگذاری</span><select @bind="_encoding"><option value="0">GSM-7 (لاتین)</option><option value="1">UCS-2 (فارسی)</option></select></label><label><span>شروع اعتبار به وقت UTC</span><input type="datetime-local" @bind="_effectiveFrom" /></label><div class="tariff-rate-editor"><header><b>بازه‌های قیمت</b><button @onclick="AddRate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> افزودن</button></header>@for (int index = 0; index < _rates.Count; index++) { int rowIndex = index; TariffRateEditor rate = _rates[index]; <div><label><span>از</span><input type="number" @bind="rate.MinChars" /></label><label><span>تا (آخرین خالی)</span><input type="number" @bind="rate.MaxChars" /></label><label><span>ریال / قطعه</span><input type="number" step="0.0001" @bind="rate.Price" /></label>@if (_rates.Count > 1) { <button class="danger" @onclick="() => RemoveRate(rowIndex)"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button> }</div> }</div> }
<label><span>پایان اعتبار UTC (اختیاری)</span><input type="datetime-local" @bind="_effectiveTo" /></label><label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> نسخه فعال باشد</label>
</div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">ذخیره</button></footer></aside> }
@code {
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<TariffItem> _items = []; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<MessageTypeItem> _messageTypes = []; private int? _editingId; private byte _providerId; private byte? _messageTypeId; private SmsEncoding _encoding = SmsEncoding.Ucs2; private DateTime _effectiveFrom = DateTime.Today; private DateTime? _effectiveTo; private bool _isActive = true; private List<TariffRateEditor> _rates = [new()]; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success; private string? SuccessMessage => _success;
    protected override Task OnInitializedAsync() => Load(); private async Task Load() { _loading = true; _error = null; Task<UiResult<IReadOnlyList<TariffItem>>> tariffsTask = Service.List(_token.Token); Task<UiResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token); Task<UiResult<IReadOnlyList<MessageTypeItem>>> typesTask = MessageTypes.List(_token.Token); await Task.WhenAll(tariffsTask, providersTask, typesTask); UiResult<IReadOnlyList<TariffItem>> tariffs = await tariffsTask; UiResult<IReadOnlyList<ProviderItem>> providers = await providersTask; UiResult<IReadOnlyList<MessageTypeItem>> types = await typesTask; _items = tariffs.Value ?? []; _providers = providers.Value ?? []; _messageTypes = types.Value ?? []; _error = tariffs.ErrorMessage ?? providers.ErrorMessage ?? types.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _providerId = 0; _messageTypeId = null; _encoding = SmsEncoding.Ucs2; _effectiveFrom = DateTime.Today; _effectiveTo = null; _isActive = true; _rates = [new()]; _editorOpen = true; } private void OpenEdit(TariffItem item) { _editingId = item.Id; _providerId = item.ProviderId; _messageTypeId = item.MessageTypeId; _encoding = item.Encoding; _effectiveFrom = item.EffectiveFromUtc; _effectiveTo = item.EffectiveToUtc; _isActive = item.IsActive; _editorOpen = true; } private void CloseEditor() => _editorOpen = false;
    private void AddRate() { TariffRateEditor previous = _rates[^1]; if (previous.MaxChars is null) previous.MaxChars = previous.MinChars; _rates.Add(new() { MinChars = (short)(previous.MaxChars.Value + 1) }); } private void RemoveRate(int index) => _rates.RemoveAt(index);
    private async Task Save() { if (_editingId is null && (_providerId == 0 || _rates.Count == 0 || _rates.Any(rate => rate.Price <= 0))) { _error = "ارائه‌دهنده و حداقل یک نرخ معتبر الزامی است."; return; } _saving = true; UiResult<string?> result; if (_editingId is null) { List<CreateTariffRateRequest> rates = _rates.Select(rate => new CreateTariffRateRequest { MinChars = rate.MinChars, MaxChars = rate.MaxChars, PricePerSegment = rate.Price }).ToList(); UiResult<CreateTariffResponse> create = await Service.Create(new CreateTariffRequest { ProviderId = _providerId, MessageTypeId = _messageTypeId, Encoding = _encoding, EffectiveFromUtc = DateTime.SpecifyKind(_effectiveFrom, DateTimeKind.Utc), EffectiveToUtc = _effectiveTo is null ? null : DateTime.SpecifyKind(_effectiveTo.Value, DateTimeKind.Utc), IsActive = _isActive, Rates = rates }, _token.Token); result = create.IsSuccess ? UiResult<string?>.Success(null) : UiResult<string?>.Failure(create.ErrorMessage!); } else result = await Service.Update(_editingId.Value, new UpdateTariffRequest { EffectiveToUtc = _effectiveTo is null ? null : DateTime.SpecifyKind(_effectiveTo.Value, DateTimeKind.Utc), IsActive = _isActive }, _token.Token); _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "نسخه تعرفه ذخیره شد."; await Load(); }
    private async Task Delete(TariffItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"نسخه تعرفه #{item.Id} حذف منطقی شود؟"); if (!confirmed) return; UiResult<string?> result = await Service.Delete(item.Id, _token.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = "نسخه تعرفه حذف شد."; await Load(); }
    private string ProviderName(byte id) => _providers.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}"; private string MessageTypeName(byte id) => _messageTypes.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}"; private static string EncodingLabel(SmsEncoding value) => value == SmsEncoding.Ucs2 ? "UCS-2 فارسی" : "GSM-7"; private static string DateLabel(DateTime value) => value.ToString("yyyy/MM/dd"); public void Dispose() { _token.Cancel(); _token.Dispose(); }
    private sealed class TariffRateEditor { public short MinChars { get; set; } = 1; public short? MaxChars { get; set; } public decimal Price { get; set; } }
}
