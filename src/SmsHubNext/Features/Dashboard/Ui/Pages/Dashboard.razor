@using SmsHubNext.Features.Dashboard.Ui
@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject ReportsService Reports
@inject DispatchOperationsService Dispatch
@inject ProvidersService Providers
@inject ProviderAccountsService ProviderAccounts
@inject SenderLinesService SenderLines
@inject CustomersService Customers
@inject BillingService Billing
@inject TimeProvider Clock
@inject SmsHubNext.Features.Providers.Esb.EsbOptions Esb
@implements IDisposable

<PageTitle>داشبورد مدیریت | SmsHub</PageTitle>
<div class="dashboard-page">
<div class="admin-page-head"><p class="dashboard-period">نمای کلی ماه <b>@PersianDisplay.Text(_jalaliMonth)</b></p><button type="button" class="admin-button secondary" disabled="_loading" @onclick="Load"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> به‌روزرسانی</button><div class="admin-page-actions"><a class="admin-button secondary" href="/admin/reports"><MudIcon Icon="@Icons.Material.Rounded.Assessment" /> گزارش‌ها</a><a class="admin-button primary" href="/admin/send"><MudIcon Icon="@Icons.Material.Rounded.Add" /> ارسال جدید</a></div></div>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Load" />
@if (!_loading)
{
<section class="admin-kpi-grid">
<article class="admin-kpi violet"><header><span>پیام‌های ماه جاری</span><i><MudIcon Icon="@Icons.Material.Rounded.Sms" /></i></header><strong>@(PersianDisplay.Number(_report?.Totals.MessageCount, "N0"))</strong><footer>@(PersianDisplay.Text(_jalaliMonth)) · @(PersianDisplay.Number(_report?.Totals.SegmentCount, "N0")) قطعه</footer></article>
<article class="admin-kpi cyan"><header><span>نرخ تحویل از کل پیام‌ها</span><i><MudIcon Icon="@Icons.Material.Rounded.DoneAll" /></i></header><strong>@(_report is null ? "—" : PersianDisplay.Number(_report.Totals.DeliveryRate, "N1") + "٪")</strong><div class="admin-progress"><i style="width:@DeliveryRateWidth"></i></div><footer>@(PersianDisplay.Number(_report?.Totals.DeliveredCount, "N0")) پیام تحویل‌شده</footer></article>
<article class="admin-kpi amber"><header><span>صف جاری ارسال</span><i><MudIcon Icon="@Icons.Material.Rounded.Schedule" /></i></header><strong>@(PersianDisplay.Number(_dispatch?.Totals.MessageCount, "N0"))</strong><footer>@(PersianDisplay.Number(_dispatch?.Totals.BatchCount, "N0")) دسته باز · @(PersianDisplay.Number(_dispatch?.Totals.HeldBatchCount, "N0")) متوقف</footer></article>
<article class="admin-kpi green"><header><span>مانده مشتری انتخاب‌شده</span><i><MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" /></i></header><strong>@(_balance is null ? "—" : PersianDisplay.Number(_balance.Balance, "N0")) <small>ریال</small></strong><footer><label>مشتری<select aria-label="مشتری مانده حساب" value="@_selectedCustomerId" @onchange="SelectCustomer" disabled="_balanceLoading"><option value="0">انتخاب مشتری</option>@foreach (CustomerItem customer in _customers.Where(item => item.IsActive)) { <option value="@customer.Id">@customer.Name</option> }</select></label>@if (_balanceLoading) { <span role="status">در حال دریافت مانده…</span> }@if (_balanceError is not null) { <span role="alert">@_balanceError</span> }</footer></article>
</section>
<section class="admin-dashboard-grid">
<article class="admin-panel admin-chart-panel"><header class="admin-panel-head"><div><h2>روند ماهانه پیام‌ها</h2><p>سال @PersianDisplay.Number(_jalaliYear) · تعداد پیام در هر ماه</p></div><a href="/admin/reports">جزئیات</a></header><div class="dashboard-month-chart" role="list" aria-label="تعداد پیام به تفکیک ماه شمسی">
@if (_monthsError is not null) { <p role="status">اطلاعات نمودار دریافت نشد؛ دوباره به‌روزرسانی کنید.</p> }
else
{
@foreach (JalaliMonthMessageReportRow month in ChartMonths)
{
    <div class="dashboard-month" role="listitem"><span>@PersianDisplay.Number(month.Stats.MessageCount, "N0")</span><div class="dashboard-month-track"><i style="height:@BarHeight(month.Stats.MessageCount)"></i></div><span dir="ltr">@PersianDisplay.Text(month.JalaliMonth)</span></div>
}
}
</div></article>
<article class="admin-panel"><header class="admin-panel-head"><div><h2>آمادگی ارائه‌دهندگان</h2><p>وضعیت پیکربندی حساب و خط ارسال</p></div><a href="/admin/settings">مدیریت</a></header><div class="admin-provider-list">@if (_readinessError is not null) { <p role="status">وضعیت اتصال دریافت نشد؛ دوباره به‌روزرسانی کنید.</p> } else { @if (_providers.Count == 0) { <div class="dashboard-list-empty">ارائه‌دهنده‌ای تعریف نشده است.</div> }@foreach (ProviderItem provider in _providers) { int readyLines = _lines.Count(line => ProviderReadiness.IsLineReady(line, provider, _accounts, Esb.Enabled)); bool ready = readyLines > 0; <div><span class="status-dot @(ready ? "online" : "pending")"></span><p><b>@provider.Name</b><small>@provider.Code · @PersianDisplay.Number(readyLines) خط متصل</small></p><em>@if (ready) { <span>پیکربندی‌شده</span> } else { <a href="/admin/sender-lines">تکمیل تنظیمات</a> }</em></div> } }</div></article>
<article class="admin-panel"><header class="admin-panel-head"><div><h2>آخرین رویدادهای عملیاتی</h2><p>آخرین وضعیت ثبت‌شده برای دسته‌های ارسال</p></div><a href="/admin/dispatch-operations">مشاهده همه</a></header><div class="admin-activity">@if (_batchError is not null) { <p role="status">رویدادهای ارسال دریافت نشد.</p> } else if (_batches.Count == 0) { <div class="dashboard-list-empty">هنوز دسته‌ای ثبت نشده است.</div> }@foreach (DispatchOperationsBatchRow batch in _batches.Take(5)) { <a href="/admin/dispatch-operations/@batch.Id"><i class="@EventIconClass(batch)"><MudIcon Icon="@EventIcon(batch)" /></i><p><b>@(batch.LastEventType is null ? $"دسته #{PersianDisplay.Number(batch.Id)}" : EventLabel(batch.LastEventType.Value))</b><small>@batch.ProviderName · @PersianDisplay.Number(batch.MessageCount) پیام · #@PersianDisplay.Number(batch.Id)</small></p><time>@EventTime(batch)</time></a> }</div></article>
<article class="admin-panel admin-next-steps"><header class="admin-panel-head"><div><h2>سلامت راه‌اندازی</h2><p>پیش‌نیازهای پیکربندی ارسال</p></div></header>@if (_readinessError is not null) { <p role="status">وضعیت پیش‌نیازها دریافت نشد؛ پس از به‌روزرسانی بررسی کنید.</p> } else { <ul><li class="@DoneClass(ReadyLines > 0)"><span>@StepIcon(ReadyLines > 0, 1)</span><p><b>اتصال سرویس پیامک</b><small>@(PersianDisplay.Number(ReadyProviders)) سرویس آماده</small><a href="/admin/provider-accounts">تنظیم اتصال</a></p></li><li class="@DoneClass(ReadyLines > 0)"><span>@StepIcon(ReadyLines > 0, 2)</span><p><b>خط ارسال متصل</b><small>@(PersianDisplay.Number(ReadyLines)) خط آماده</small><a href="/admin/sender-lines">مدیریت خطوط</a></p></li><li class="@DoneClass((_report?.Totals.MessageCount ?? 0) > 0)"><span>@StepIcon((_report?.Totals.MessageCount ?? 0) > 0, 3)</span><p><b>جریان پیام</b><small>@((_report?.Totals.MessageCount ?? 0) > 0 ? "داده واقعی ثبت شده است" : "هنوز پیامی در ماه جاری نیست")</small></p></li></ul> }</article>
</section>

}
</div>

@code {
private IReadOnlyList<CustomerItem> _customers = [];
private short _selectedCustomerId;
private bool _balanceLoading;
private string? _balanceError;
private int ReadyLines => _lines.Count(line => _providers.Any(provider => ProviderReadiness.IsLineReady(line, provider, _accounts, Esb.Enabled)));
private int ReadyProviders => _providers.Count(provider => _lines.Any(line => ProviderReadiness.IsLineReady(line, provider, _accounts, Esb.Enabled)));
private async Task SelectCustomer(ChangeEventArgs args)
{
    if (!short.TryParse(Convert.ToString(args.Value), out short id)) return;
    _selectedCustomerId = id;
    await LoadBalance();
}
private async Task LoadBalance()
{
    _balance = null;
    _balanceError = null;
    if (_selectedCustomerId == 0) return;
    short requestedId = _selectedCustomerId;
    _balanceLoading = true;
    try
    {
        UiResult<CustomerBalanceItem> result = await Billing.GetBalance(requestedId, _token.Token);
        if (requestedId != _selectedCustomerId) return;
        _balance = result.Value;
        _balanceError = result.ErrorMessage;
    }
    finally { _balanceLoading = false; }
}
private readonly CancellationTokenSource _token = new(); private MessageReportSummary? _report; private DispatchOperationsSummary? _dispatch; private IReadOnlyList<JalaliMonthMessageReportRow> _months = []; private IReadOnlyList<DispatchOperationsBatchRow> _batches = []; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<ProviderAccountItem> _accounts = []; private IReadOnlyList<SenderLineItem> _lines = []; private CustomerBalanceItem? _balance; private string _jalaliMonth = string.Empty; private int _jalaliYear; private bool _loading = true; private string? _error;
protected override Task OnInitializedAsync() => Load();
private string? _monthsError, _readinessError, _batchError;
private async Task Load()
{
    if (_refreshing) return;
    _refreshing = _loading = true;
    _balance = null;
    _error = null;
    try
    {
        DateTime localNow = IranTime.FromUtc(Clock.GetUtcNow());
        System.Globalization.PersianCalendar calendar = new();
        _jalaliYear = calendar.GetYear(localNow);
        int month = calendar.GetMonth(localNow);
        _jalaliMonth = FormattableString.Invariant($"{_jalaliYear:0000}/{month:00}");
        MessageReportRequest monthQuery = new()
        {
            FromJalali = $"{_jalaliMonth}/01",
            ToJalali = FormattableString.Invariant($"{_jalaliMonth}/{calendar.GetDaysInMonth(_jalaliYear, month):00}"),
        };
        MessageReportRequest yearQuery = new()
        {
            FromJalali = FormattableString.Invariant($"{_jalaliYear:0000}/01/01"),
            ToJalali = FormattableString.Invariant($"{_jalaliYear:0000}/12/{calendar.GetDaysInMonth(_jalaliYear, 12):00}"),
        };
        Task<UiResult<MessageReportSummary>> reportTask = Reports.Summary(monthQuery, _token.Token);
        Task<UiResult<IReadOnlyList<JalaliMonthMessageReportRow>>> monthsTask = Reports.ByMonth(yearQuery, _token.Token);
        Task<UiResult<DispatchOperationsSummary>> dispatchTask = Dispatch.Summary(false, _token.Token);
        Task<UiResult<DispatchOperationsBatchPage>> batchesTask = Dispatch.Batches(false, 1, 8, _token.Token);
        Task<UiResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token);
        Task<UiResult<IReadOnlyList<ProviderAccountItem>>> accountsTask = ProviderAccounts.List(_token.Token);
        Task<UiResult<IReadOnlyList<SenderLineItem>>> linesTask = SenderLines.List(_token.Token);
        Task<UiResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_token.Token);
        await Task.WhenAll(reportTask, monthsTask, dispatchTask, batchesTask, providersTask, accountsTask, linesTask, customersTask);
        UiResult<MessageReportSummary> report = await reportTask;
        UiResult<IReadOnlyList<JalaliMonthMessageReportRow>> months = await monthsTask;
        UiResult<DispatchOperationsSummary> dispatch = await dispatchTask;
        UiResult<DispatchOperationsBatchPage> batches = await batchesTask;
        UiResult<IReadOnlyList<ProviderItem>> providers = await providersTask;
        UiResult<IReadOnlyList<ProviderAccountItem>> accounts = await accountsTask;
        UiResult<IReadOnlyList<SenderLineItem>> lines = await linesTask;
        UiResult<IReadOnlyList<CustomerItem>> customers = await customersTask;
        _report = report.Value;
        _months = months.Value ?? [];
        _dispatch = dispatch.Value;
        _batches = batches.Value?.Items ?? [];
        _providers = providers.Value ?? [];
        _accounts = accounts.Value ?? [];
        _lines = lines.Value ?? [];
        _customers = customers.Value ?? [];
        if (!_customers.Any(item => item.Id == _selectedCustomerId && item.IsActive)) _selectedCustomerId = 0;
        _monthsError = months.ErrorMessage;
        _readinessError = providers.ErrorMessage ?? accounts.ErrorMessage ?? lines.ErrorMessage;
        _batchError = batches.ErrorMessage;
        _error = report.ErrorMessage ?? _monthsError ?? dispatch.ErrorMessage ?? _batchError ?? _readinessError ?? customers.ErrorMessage;
        await LoadBalance();
    }
    finally { _loading = _refreshing = false; }
}
private bool _refreshing;
private IEnumerable<JalaliMonthMessageReportRow> ChartMonths => Enumerable.Range(1, int.Parse(_jalaliMonth[5..], System.Globalization.CultureInfo.InvariantCulture))
    .Select(month => FormattableString.Invariant($"{_jalaliYear:0000}/{month:00}"))
    .Select(month => _months.FirstOrDefault(row => row.JalaliMonth == month) ?? new JalaliMonthMessageReportRow(month, new MessageReportStats(0,0,0,0,0,0,0,0,0)));
private string DeliveryRateWidth => $"{Math.Clamp(_report?.Totals.DeliveryRate ?? 0, 0, 100):0.##}%"; private string BarHeight(long count) { long maximum = Math.Max(1, _months.Select(item => item.Stats.MessageCount).DefaultIfEmpty(0).Max()); return FormattableString.Invariant($"{count * 100d / maximum:0.#}%"); } private static string EventLabel(MessageBatchEventType type) => type switch { MessageBatchEventType.Accepted => "پذیرش دسته", MessageBatchEventType.DispatchStarted => "شروع ارسال", MessageBatchEventType.Held => "توقف دسته", MessageBatchEventType.DispatchCompleted => "تکمیل ارسال", MessageBatchEventType.DispatchFailed => "شکست ارسال", MessageBatchEventType.DeliveryUpdated => "به‌روزرسانی تحویل", MessageBatchEventType.DispatchRetryRequested => "تلاش مجدد", _ => "به‌روزرسانی دسته" }; private static string EventIconClass(DispatchOperationsBatchRow batch) => batch.Status is BatchStatus.DispatchCompleted ? "ok" : batch.Status is BatchStatus.DispatchFailed or BatchStatus.Rejected ? "error" : "wait"; private static string EventIcon(DispatchOperationsBatchRow batch) => batch.Status is BatchStatus.DispatchCompleted ? Icons.Material.Rounded.Done : batch.Status is BatchStatus.DispatchFailed or BatchStatus.Rejected ? Icons.Material.Rounded.ErrorOutline : Icons.Material.Rounded.Schedule; private static string EventTime(DispatchOperationsBatchRow batch) => PersianDisplay.Date(IranTime.FromUtc(new DateTimeOffset(DateTime.SpecifyKind(batch.LastEventTimeUtc ?? batch.StatusChangedAtUtc, DateTimeKind.Utc))), "MM/dd HH:mm"); private static string? DoneClass(bool done) => done ? "done" : null; private static RenderFragment StepIcon(bool done, int step) => builder => { if (done) builder.OpenComponent<MudIcon>(0); if (done) builder.AddAttribute(1, "Icon", Icons.Material.Rounded.Done); if (done) builder.CloseComponent(); else builder.AddContent(2, PersianDisplay.Number(step)); }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
