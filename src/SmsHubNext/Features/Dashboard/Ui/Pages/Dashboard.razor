@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject ReportsService Reports
@inject DispatchOperationsService Dispatch
@inject ProvidersService Providers
@inject ProviderAccountsService ProviderAccounts
@inject SenderLinesService SenderLines
@inject CustomersService Customers
@inject BillingService Billing
@inject TimeProvider Clock
@inject SmsHubNext.Features.Providers.Esb.EsbOptions Esb
@implements IDisposable

<PageTitle>داشبورد مدیریت | SmsHub</PageTitle>
<div class="admin-page-head"><div class="admin-page-actions"><a class="admin-button secondary" href="/admin/reports"><MudIcon Icon="@Icons.Material.Rounded.Assessment" /> گزارش‌ها</a><a class="admin-button primary" href="/admin/send"><MudIcon Icon="@Icons.Material.Rounded.Add" /> ارسال جدید</a></div></div>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Load" />
<section class="admin-kpi-grid">
<article class="admin-kpi violet"><header><span>پیام‌های ماه جاری</span><i><MudIcon Icon="@Icons.Material.Rounded.Sms" /></i></header><strong>@(_report?.Totals.MessageCount.ToString("N0") ?? "—")</strong><footer>@_jalaliMonth · @(_report?.Totals.SegmentCount.ToString("N0") ?? "۰") قطعه</footer></article>
<article class="admin-kpi cyan"><header><span>نرخ تحویل</span><i><MudIcon Icon="@Icons.Material.Rounded.DoneAll" /></i></header><strong>@(_report is null ? "—" : $"{_report.Totals.DeliveryRate:N1}٪")</strong><div class="admin-progress"><i style="width:@DeliveryRateWidth"></i></div><footer>@(_report?.Totals.DeliveredCount.ToString("N0") ?? "۰") پیام تحویل‌شده</footer></article>
<article class="admin-kpi amber"><header><span>در انتظار عملیات</span><i><MudIcon Icon="@Icons.Material.Rounded.Schedule" /></i></header><strong>@(_dispatch?.Totals.MessageCount.ToString("N0") ?? "—")</strong><footer>@(_dispatch?.Totals.BatchCount.ToString("N0") ?? "۰") دسته باز · @(_dispatch?.Totals.HeldBatchCount.ToString("N0") ?? "۰") متوقف</footer></article>
<article class="admin-kpi green"><header><span>مانده مشتری پیش‌فرض</span><i><MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" /></i></header><strong>@(_balance is null ? "—" : _balance.Balance.ToString("N0")) <small>ریال</small></strong><footer>@(_selectedCustomer?.Name ?? "مشتری فعالی موجود نیست")</footer></article>
</section>
<section class="admin-dashboard-grid">
<article class="admin-panel admin-chart-panel"><header class="admin-panel-head"><div><h2>روند ماهانه پیام‌ها</h2><p>سال جلالی @_jalaliYear از داده واقعی Message</p></div><a href="/admin/reports">جزئیات</a></header><div class="admin-chart-legend"><span><i></i> تعداد پیام</span></div><div class="admin-chart dashboard-real-chart">@if (_months.Count == 0) { <div class="dashboard-chart-empty">داده‌ای برای سال جاری ثبت نشده است.</div> } else { @foreach (JalaliMonthMessageReportRow month in _months) { <i title="@month.JalaliMonth: @month.Stats.MessageCount پیام" style="height:@BarHeight(month.Stats.MessageCount)"></i> } }</div><div class="admin-chart-axis">@foreach (JalaliMonthMessageReportRow month in _months) { <span>@month.JalaliMonth[5..]</span> }</div></article>
<article class="admin-panel"><header class="admin-panel-head"><div><h2>آمادگی ارائه‌دهندگان</h2><p>حساب محرمانه و خط متصل فعال</p></div><a href="/admin/settings">مدیریت</a></header><div class="admin-provider-list">@if (_providers.Count == 0) { <div class="dashboard-list-empty">ارائه‌دهنده‌ای تعریف نشده است.</div> }@foreach (ProviderItem provider in _providers) { bool accountReady = _accounts.Any(item => item.ProviderId == provider.Id && item.IsActive && item.HasSecret) || (Esb.Enabled && provider.Code == "4040" && _lines.Any(item => item.ProviderId == provider.Id && item.IsActive && item.UseEsb)); int readyLines = _lines.Count(item => item.ProviderId == provider.Id && item.IsActive && (item.UseEsb || item.ProviderAccountId is not null)); bool ready = provider.IsActive && accountReady && readyLines > 0; <div><span class="status-dot @(ready ? "online" : "pending")"></span><p><b>@provider.Name</b><small>@provider.Code · @readyLines خط آماده</small></p><em>@(ready ? "آماده ارسال" : "نیازمند پیکربندی")</em></div> }</div></article>
<article class="admin-panel"><header class="admin-panel-head"><div><h2>آخرین رویدادهای عملیاتی</h2><p>آخرین event ثبت‌شده روی دسته‌ها</p></div><a href="/admin/dispatch-operations">مشاهده همه</a></header><div class="admin-activity">@if (_batches.Count == 0) { <div class="dashboard-list-empty">هنوز دسته‌ای ثبت نشده است.</div> }@foreach (DispatchOperationsBatchRow batch in _batches.Take(5)) { <a href="/admin/dispatch-operations/@batch.Id"><i class="@EventIconClass(batch)"><MudIcon Icon="@EventIcon(batch)" /></i><p><b>@(batch.LastEventType is null ? $"دسته #{batch.Id}" : EventLabel(batch.LastEventType.Value))</b><small>@batch.ProviderName · @batch.MessageCount پیام · #@batch.Id</small></p><time>@EventTime(batch)</time></a> }</div></article>
<article class="admin-panel admin-next-steps"><header class="admin-panel-head"><div><h2>سلامت راه‌اندازی</h2><p>کنترل خودکار پیش‌نیازهای ارسال واقعی</p></div></header><ul><li class="@DoneClass(_accounts.Any(item => item.IsActive && item.HasSecret))"><span>@StepIcon(_accounts.Any(item => item.IsActive && item.HasSecret), 1)</span><p><b>حساب ارائه‌دهنده</b><small>@_accounts.Count(item => item.IsActive && item.HasSecret) حساب آماده</small></p></li><li class="@DoneClass(_lines.Any(item => item.IsActive && (item.UseEsb || item.ProviderAccountId is not null)))"><span>@StepIcon(_lines.Any(item => item.IsActive && (item.UseEsb || item.ProviderAccountId is not null)), 2)</span><p><b>خط ارسال متصل</b><small>@_lines.Count(item => item.IsActive && (item.UseEsb || item.ProviderAccountId is not null)) خط آماده</small></p></li><li class="@DoneClass((_report?.Totals.MessageCount ?? 0) > 0)"><span>@StepIcon((_report?.Totals.MessageCount ?? 0) > 0, 3)</span><p><b>جریان پیام</b><small>@((_report?.Totals.MessageCount ?? 0) > 0 ? "داده واقعی ثبت شده است" : "هنوز پیامی در ماه جاری نیست")</small></p></li></ul></article>
</section>

@code {
private readonly CancellationTokenSource _token = new(); private MessageReportSummary? _report; private DispatchOperationsSummary? _dispatch; private IReadOnlyList<JalaliMonthMessageReportRow> _months = []; private IReadOnlyList<DispatchOperationsBatchRow> _batches = []; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<ProviderAccountItem> _accounts = []; private IReadOnlyList<SenderLineItem> _lines = []; private CustomerItem? _selectedCustomer; private CustomerBalanceItem? _balance; private string _jalaliMonth = string.Empty; private int _jalaliYear; private bool _loading = true; private string? _error;
protected override Task OnInitializedAsync() => Load();
private async Task Load() { _loading = true; _error = null; DateTime localNow = Clock.GetLocalNow().DateTime; System.Globalization.PersianCalendar calendar = new(); _jalaliYear = calendar.GetYear(localNow); int month = calendar.GetMonth(localNow); _jalaliMonth = $"{_jalaliYear:0000}/{month:00}"; MessageReportRequest monthQuery = new() { FromJalali = $"{_jalaliMonth}/01", ToJalali = $"{_jalaliMonth}/31" }; MessageReportRequest yearQuery = new() { FromJalali = $"{_jalaliYear:0000}/01/01", ToJalali = $"{_jalaliYear:0000}/12/30" }; Task<UiResult<MessageReportSummary>> reportTask = Reports.Summary(monthQuery, _token.Token); Task<UiResult<IReadOnlyList<JalaliMonthMessageReportRow>>> monthsTask = Reports.ByMonth(yearQuery, _token.Token); Task<UiResult<DispatchOperationsSummary>> dispatchTask = Dispatch.Summary(false, _token.Token); Task<UiResult<DispatchOperationsBatchPage>> batchesTask = Dispatch.Batches(false, 1, 8, _token.Token); Task<UiResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token); Task<UiResult<IReadOnlyList<ProviderAccountItem>>> accountsTask = ProviderAccounts.List(_token.Token); Task<UiResult<IReadOnlyList<SenderLineItem>>> linesTask = SenderLines.List(_token.Token); Task<UiResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_token.Token); await Task.WhenAll(reportTask, monthsTask, dispatchTask, batchesTask, providersTask, accountsTask, linesTask, customersTask); UiResult<MessageReportSummary> report = await reportTask; UiResult<IReadOnlyList<JalaliMonthMessageReportRow>> months = await monthsTask; UiResult<DispatchOperationsSummary> dispatch = await dispatchTask; UiResult<DispatchOperationsBatchPage> batches = await batchesTask; UiResult<IReadOnlyList<ProviderItem>> providers = await providersTask; UiResult<IReadOnlyList<ProviderAccountItem>> accounts = await accountsTask; UiResult<IReadOnlyList<SenderLineItem>> lines = await linesTask; UiResult<IReadOnlyList<CustomerItem>> customers = await customersTask; _report = report.Value; _months = months.Value ?? []; _dispatch = dispatch.Value; _batches = batches.Value?.Items ?? []; _providers = providers.Value ?? []; _accounts = accounts.Value ?? []; _lines = lines.Value ?? []; IReadOnlyList<CustomerItem> customerItems = customers.Value ?? []; _selectedCustomer = customerItems.FirstOrDefault(item => item.IsActive); _error = report.ErrorMessage ?? months.ErrorMessage ?? dispatch.ErrorMessage ?? batches.ErrorMessage ?? providers.ErrorMessage ?? accounts.ErrorMessage ?? lines.ErrorMessage ?? customers.ErrorMessage; if (_error is null && _selectedCustomer is not null) { UiResult<CustomerBalanceItem> balance = await Billing.GetBalance(_selectedCustomer.Id, _token.Token); _balance = balance.Value; _error = balance.ErrorMessage; } _loading = false; }
private string DeliveryRateWidth => $"{Math.Clamp(_report?.Totals.DeliveryRate ?? 0, 0, 100):0.##}%"; private string BarHeight(long count) { long maximum = Math.Max(1, _months.Max(item => item.Stats.MessageCount)); return $"{Math.Max(8, count * 100d / maximum):0.#}%"; } private static string EventLabel(MessageBatchEventType type) => type switch { MessageBatchEventType.Accepted => "پذیرش دسته", MessageBatchEventType.DispatchStarted => "شروع ارسال", MessageBatchEventType.Held => "توقف دسته", MessageBatchEventType.DispatchCompleted => "تکمیل ارسال", MessageBatchEventType.DispatchFailed => "شکست ارسال", MessageBatchEventType.DeliveryUpdated => "به‌روزرسانی تحویل", MessageBatchEventType.DispatchRetryRequested => "تلاش مجدد", _ => "به‌روزرسانی دسته" }; private static string EventIconClass(DispatchOperationsBatchRow batch) => batch.Status is BatchStatus.DispatchCompleted ? "ok" : batch.Status is BatchStatus.DispatchFailed or BatchStatus.Rejected ? "error" : "wait"; private static string EventIcon(DispatchOperationsBatchRow batch) => batch.Status is BatchStatus.DispatchCompleted ? Icons.Material.Rounded.Done : batch.Status is BatchStatus.DispatchFailed or BatchStatus.Rejected ? Icons.Material.Rounded.ErrorOutline : Icons.Material.Rounded.Schedule; private static string EventTime(DispatchOperationsBatchRow batch) => (batch.LastEventTimeUtc ?? batch.StatusChangedAtUtc).ToString("MM/dd HH:mm"); private static string? DoneClass(bool done) => done ? "done" : null; private static RenderFragment StepIcon(bool done, int step) => builder => { if (done) builder.OpenComponent<MudIcon>(0); if (done) builder.AddAttribute(1, "Icon", Icons.Material.Rounded.Done); if (done) builder.CloseComponent(); else builder.AddContent(2, step); }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
