@page "/admin/reports"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject ReportsService Service
@implements IDisposable

<PageTitle>گزارش پیام‌ها | SmsHub</PageTitle>
<div class="admin-page-head"><button class="admin-button secondary" @onclick="Load"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> به‌روزرسانی</button></div>
<section class="report-filters"><label><span>از تاریخ جلالی</span><input @bind="_from" dir="ltr" placeholder="1405/07/01" /></label><label><span>تا تاریخ جلالی</span><input @bind="_to" dir="ltr" placeholder="1405/07/30" /></label><button class="admin-button primary" @onclick="Load">اعمال بازه</button></section>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Load" />
@if (_summary is not null)
{
    <section class="dispatch-kpis"><article><span>کل پیام‌ها</span><b>@_summary.Totals.MessageCount.ToString("N0")</b><small>@_summary.Totals.SegmentCount.ToString("N0") قطعه</small></article><article><span>تحویل‌شده</span><b>@_summary.Totals.DeliveredCount.ToString("N0")</b><small>@_summary.Totals.DeliveryRate.ToString("N1")٪ نرخ تحویل</small></article><article class="danger"><span>تحویل‌نشده</span><b>@_summary.Totals.UndeliveredCount.ToString("N0")</b><small>@_summary.Totals.ExpiredCount.ToString("N0") منقضی</small></article><article><span>هزینه کل</span><b>@_summary.Totals.TotalCost.ToString("N0")</b><small>ریال</small></article></section>
}
<div class="report-grid"><section class="admin-data-panel"><header><div><h2>بر اساس ارائه‌دهنده</h2><span>مقایسه مسیرهای ارسال</span></div></header><div class="admin-table-wrap"><AdminGrid T="ProviderMessageReportRow" Items="@(_providers)" Loading="_loading" Name="گزارش ارسال" ExportColumns='@(new AdminExportColumn<ProviderMessageReportRow>[] { new("ارائه‌دهنده", row => row.ProviderName), new("پیام", row => row.Stats.MessageCount), new("هزینه", row => row.Stats.TotalCost), new("نرخ تحویل", row => row.Stats.DeliveryRate) })'><PropertyColumn Property="row => row.ProviderName" Title="ارائه‌دهنده"><CellTemplate><div>@context.Item.ProviderName<small class="table-sub">@context.Item.ProviderCode</small></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.MessageCount" Title="پیام"><CellTemplate><div>@context.Item.Stats.MessageCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.TotalCost" Title="هزینه"><CellTemplate><div class="money">@context.Item.Stats.TotalCost.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.DeliveryRate" Title="نرخ تحویل"><CellTemplate><div><span class="report-rate">@context.Item.Stats.DeliveryRate.ToString("N1")٪</span></div></CellTemplate></PropertyColumn></AdminGrid></div></section>
<section class="admin-data-panel"><header><div><h2>بر اساس نوع پیام</h2><span>تفکیک کاربرد پیام</span></div></header><div class="admin-table-wrap"><AdminGrid T="MessageTypeReportRow" Items="@(_types)" Loading="_loading" Name="گزارش ارسال" ExportColumns='@(new AdminExportColumn<MessageTypeReportRow>[] { new("نوع پیام", row => row.MessageTypeName), new("پیام", row => row.Stats.MessageCount), new("قطعه", row => row.Stats.SegmentCount), new("هزینه", row => row.Stats.TotalCost) })'><PropertyColumn Property="row => row.MessageTypeName" Title="نوع پیام"><CellTemplate><div>@context.Item.MessageTypeName<small class="table-sub">@context.Item.MessageTypeCode</small></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.MessageCount" Title="پیام"><CellTemplate><div>@context.Item.Stats.MessageCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.SegmentCount" Title="قطعه"><CellTemplate><div>@context.Item.Stats.SegmentCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.TotalCost" Title="هزینه"><CellTemplate><div class="money">@context.Item.Stats.TotalCost.ToString("N0")</div></CellTemplate></PropertyColumn></AdminGrid></div></section></div>
<section class="admin-data-panel"><header><div><h2>روند ماهانه جلالی</h2><span>مبنای گزارش همان کلید دوره ذخیره‌شده روی پیام است.</span></div></header><div class="admin-table-wrap"><AdminGrid T="JalaliMonthMessageReportRow" Items="@(_months)" Loading="_loading" Name="گزارش ارسال" ExportColumns='@(new AdminExportColumn<JalaliMonthMessageReportRow>[] { new("ماه", row => row.JalaliMonth), new("پیام", row => row.Stats.MessageCount), new("تحویل‌شده", row => row.Stats.DeliveredCount), new("تحویل‌نشده", row => row.Stats.UndeliveredCount), new("نرخ تحویل", row => row.Stats.DeliveryRate), new("هزینه", row => row.Stats.TotalCost) })'><PropertyColumn Property="row => row.JalaliMonth" Title="ماه"><CellTemplate><div class="mono">@context.Item.JalaliMonth</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.MessageCount" Title="پیام"><CellTemplate><div>@context.Item.Stats.MessageCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.DeliveredCount" Title="تحویل‌شده"><CellTemplate><div>@context.Item.Stats.DeliveredCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.UndeliveredCount" Title="تحویل‌نشده"><CellTemplate><div>@context.Item.Stats.UndeliveredCount.ToString("N0")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.DeliveryRate" Title="نرخ تحویل"><CellTemplate><div>@context.Item.Stats.DeliveryRate.ToString("N1")٪</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="row => row.Stats.TotalCost" Title="هزینه"><CellTemplate><div class="money">@context.Item.Stats.TotalCost.ToString("N0") ریال</div></CellTemplate></PropertyColumn></AdminGrid></div></section>

@code {
    private readonly CancellationTokenSource _token = new(); private string _from = "1405/07/01"; private string _to = "1405/07/30"; private MessageReportSummary? _summary; private IReadOnlyList<ProviderMessageReportRow> _providers = []; private IReadOnlyList<MessageTypeReportRow> _types = []; private IReadOnlyList<JalaliMonthMessageReportRow> _months = []; private bool _loading = true; private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; MessageReportRequest query = new() { FromJalali = _from.Trim(), ToJalali = _to.Trim() }; Task<UiResult<MessageReportSummary>> summaryTask = Service.Summary(query, _token.Token); Task<UiResult<IReadOnlyList<ProviderMessageReportRow>>> providersTask = Service.ByProvider(query, _token.Token); Task<UiResult<IReadOnlyList<MessageTypeReportRow>>> typesTask = Service.ByMessageType(query, _token.Token); Task<UiResult<IReadOnlyList<JalaliMonthMessageReportRow>>> monthsTask = Service.ByMonth(query, _token.Token); await Task.WhenAll(summaryTask, providersTask, typesTask, monthsTask); UiResult<MessageReportSummary> summary = await summaryTask; UiResult<IReadOnlyList<ProviderMessageReportRow>> providers = await providersTask; UiResult<IReadOnlyList<MessageTypeReportRow>> types = await typesTask; UiResult<IReadOnlyList<JalaliMonthMessageReportRow>> months = await monthsTask; _summary = summary.Value; _providers = providers.Value ?? []; _types = types.Value ?? []; _months = months.Value ?? []; _error = summary.ErrorMessage ?? providers.ErrorMessage ?? types.ErrorMessage ?? months.ErrorMessage; _loading = false; }
    public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
