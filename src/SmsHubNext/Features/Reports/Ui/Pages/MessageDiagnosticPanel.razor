@using SmsHubNext.Features.Reports.Ui
@inject ReportsService Service
@inject IJSRuntime JS
@implements IDisposable

<section class="diagnostic-panel" aria-label="جزئیات عیب‌یابی پیامک" aria-live="polite">
    @if (!InDialog)
    {
        <header class="diagnostic-heading"><h2>عیب‌یابی پیام @PersianDisplay.Number(MessageId)</h2><MudTooltip Text="بستن جزئیات" ShowOnFocus="true"><button type="button" class="diagnostic-close" aria-label="بستن جزئیات" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></MudTooltip></header>
    }
    <div class="diagnostic-actions">
        <button type="button" class="diagnostic-action primary" disabled="@_loading" @onclick="() => Load(true)"><MudIcon Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" />استعلام زنده تحویل</button>
        <button type="button" class="diagnostic-action" disabled="@(_loading || _report is null)" @onclick="Copy"><MudIcon Icon="@Icons.Material.Rounded.ContentCopy" Size="Size.Small" />کپی گزارش</button>
        <MudTooltip Text="زمان‌ها شمسی و به وقت ایران‌اند. زمان مشاهدهٔ تحویل، الزاماً زمان رسیدن به گوشی نیست. استعلام زنده فقط وضعیت را می‌خواند." ShowOnFocus="true"><button type="button" class="diagnostic-info" aria-label="راهنمای زمان و استعلام تحویل"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /></button></MudTooltip>
    </div>
    <FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="() => Load(false)" />
    @if (_report is not null)
    {
        <div class="diagnostic-assessment"><MudIcon Icon="@Icons.Material.Rounded.Assignment" /><p>@MessageDiagnosticText.Assessment(_report)</p></div>
        <dl class="diagnostic-facts">
            <div><dt>گیرنده</dt><dd dir="ltr">@PersianDisplay.Text(_report.Message.MobileNumber)</dd></div>
            <div><dt>وضعیت دسته</dt><dd>@MessageDiagnosticText.Batch(_report.Message.BatchStatus)<small>@MessageDiagnosticText.Reason(_report.Message.StatusReason)</small></dd></div>
            <div><dt>ثبت پیام</dt><dd>@MessageDiagnosticText.Time(_report.Message.SubmittedAtUtc)</dd></div>
            <div><dt>دسته</dt><dd><a class="diagnostic-batch" href="/admin/dispatch-operations/@_report.Message.MessageBatchId">مشاهده دسته @PersianDisplay.Number(_report.Message.MessageBatchId)<MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" /></a></dd></div>
        </dl>
        <details class="diagnostic-extra"><summary>شناسه‌ها و زمان‌های تکمیلی</summary><dl class="diagnostic-facts">
            <div><dt>شروع ارسال دسته</dt><dd>@MessageDiagnosticText.Time(_report.Message.DispatchStartedAtUtc)</dd></div>
            <div><dt>مشاهده تحویل در سامانه</dt><dd>@MessageDiagnosticText.Time(_report.Message.DeliveredAtUtc)</dd></div>
            <div><dt>@(_report.Message.ProviderCode == "4040" ? "شناسه پیام / شناسه ارسالی ۴۰۴۰" : "شناسه پیام")</dt><dd dir="ltr">@PersianDisplay.Number(_report.Message.Id)</dd></div>
            <div><dt>شناسه سرویس</dt><dd dir="ltr">@(_report.Message.ProviderMessageId ?? "—")</dd></div>
        </dl></details>
        @if (_report.LiveError is not null) { <p class="diagnostic-live-error" role="status">@_report.LiveError</p> }
        @if (_report.LiveFailure is not null) { <p class="diagnostic-live-error" role="status">@MessageDiagnosticText.Failure(_report.LiveFailure)</p> }
        @if (_report.Live is { HasProviderStatus: true } live)
        {
            <section class="diagnostic-live"><h3><MudIcon Icon="@Icons.Material.Rounded.Sensors" Size="Size.Small" />نتیجه استعلام زنده</h3><p>کد @PersianDisplay.Number(live.RawStatusCode) — @MessageDiagnosticText.Dlr(_report.Message.ProviderCode, live.RawStatusCode)</p><small>زمان مشاهده: @MessageDiagnosticText.Time(_report.LiveObservedAtUtc)</small><details><summary>زمان‌های خام سرویس</summary><p dir="ltr">DateSent: @(live.ProviderSentAtRaw ?? "—") / DateDlr: @(live.ProviderDlrAtRaw ?? "—")</p><small>قالب و منطقه زمانی این مقادیر تأیید نشده است.</small></details></section>
        }
        <section class="diagnostic-section">
            <header><h3><MudIcon Icon="@Icons.Material.Rounded.Timeline" Size="Size.Small" />رویدادها و خطاهای دسته</h3><span class="diagnostic-count">@PersianDisplay.Number(_report.Events.Count)</span><MudTooltip Text="رویدادها متعلق به کل دسته‌اند؛ فقط با ثبت شناسه در شرح می‌توان آن‌ها را به پیام مشخص نسبت داد." ShowOnFocus="true"><button type="button" class="diagnostic-info" aria-label="راهنمای ارتباط رویدادها با پیام"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /></button></MudTooltip></header>
            @if (_report.Events.Count == 0) { <p class="diagnostic-empty">رویدادی نگهداری نشده است.</p> }
            <div class="diagnostic-timeline">
                @foreach (DiagnosticEvent item in _report.Events)
                {
                    <details class="diagnostic-event"><summary><time>@MessageDiagnosticText.Time(item.EventTimeUtc)</time><span>@MessageDiagnosticText.EventTitle(item.EventType)</span>@if (item.ProviderResultCode is not null) { <span class="diagnostic-code">کد ثبت‌شده @PersianDisplay.Number(item.ProviderResultCode)</span> }</summary><p>@item.Detail</p>@if (item.Failure is not null) { <p>@MessageDiagnosticText.Failure(item.Failure)</p> }</details>
                }
            </div>
            <a class="diagnostic-log-link" href="/admin/settings/errors">مشاهده خطاهای داخلی سیستم ←</a>
        </section>
        <section class="diagnostic-section"><header><h3><MudIcon Icon="@Icons.Material.Rounded.MarkEmailRead" Size="Size.Small" />تاریخچه تحویل</h3><span class="diagnostic-count">@PersianDisplay.Number(_report.Deliveries.Count)</span></header>
            @if (_report.Deliveries.Count == 0) { <p class="diagnostic-empty">گزارش تحویلی ذخیره نشده است.</p> }
            @foreach (DiagnosticDelivery item in _report.Deliveries) { <div class="diagnostic-delivery"><time>@MessageDiagnosticText.Time(item.ReceivedAtUtc)</time><span>کد @PersianDisplay.Number(item.RawStatusCode) — @MessageDiagnosticText.StoredDlr(_report.Message.ProviderCode, item)</span></div> }
        </section>
        <details class="diagnostic-extra" open="@_copyFailed"><summary>گزارش کامل و متن پیام</summary><textarea class="diagnostic-copy" readonly aria-label="متن گزارش عیب‌یابی برای کپی دستی">@MessageDiagnosticText.Copy(_report)</textarea></details>
    }
</section>

@code {
    [Parameter] public long MessageId { get; set; }
    [Parameter] public bool InDialog { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private MessageDiagnostics? _report;
    private bool _loading, _copyFailed;
    private long? _loadedMessageId;
    private string? _error, _success;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedMessageId == MessageId) return;
        _loadedMessageId = MessageId;
        _report = null;
        _copyFailed = false;
        await Load(false);
    }
    private async Task Load(bool live)
    {
        if (_loading) return;
        _loading = true; _error = null; _success = null;
        try
        {
            UiResult<MessageDiagnostics> result = await Service.Diagnostics(MessageId, live, _lifetime.Token);
            if (result.IsSuccess) _report = result.Value;
            else _error = result.ErrorMessage;
        }
        finally { _loading = false; }
    }
    private async Task Copy()
    {
        if (_report is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", MessageDiagnosticText.Copy(_report)); _success = "گزارش عیب‌یابی کپی شد."; _copyFailed = false; }
        catch (JSException) { _copyFailed = true; _error = "کپی خودکار ممکن نشد؛ متن گزارش کامل را انتخاب و کپی کنید."; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
