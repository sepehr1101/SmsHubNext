@page "/admin/billing"
@layout AdminLayout
@attribute [Authorize(Policy = DevelopmentAccount.ManagementPolicy)]
@inject BillingService Service
@inject CustomersService Customers
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>حسابداری | SmsHub</PageTitle>
<div class="admin-page-head"><button class="admin-button primary" disabled="@(_customerId == 0)" @onclick="OpenTopUp"><MudIcon Icon="@Icons.Material.Rounded.AddCard" /> افزایش اعتبار</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
<div class="billing-customer-row"><label><span>مشتری</span><select @bind="_customerId" @bind:after="LoadAccount"><option value="0">انتخاب کنید</option>@foreach (CustomerItem customer in _customers.Where(item => item.IsActive)) { <option value="@customer.Id">@customer.Name</option> }</select></label><article><span>مانده قابل استفاده</span><strong>@((_balance?.Balance ?? 0).ToString("N0")) <small>ریال</small></strong><em>آخرین تغییر: @(_balance is null ? "—" : _balance.UpdatedAtUtc.ToString("yyyy/MM/dd HH:mm")) UTC</em></article></div>
<section class="admin-data-panel"><header><div><h2>دفتر تراکنش‌ها</h2><span>این فهرست append-only است و ردیفی از آن ویرایش یا حذف نمی‌شود.</span></div></header><div class="admin-table-wrap"><AdminGrid T="BalanceTransactionItem" Items="@(_transactions)" Loading="_loading" Name="حسابداری" ExportColumns='@(new AdminExportColumn<BalanceTransactionItem>[] { new("زمان UTC", item => item.CreatedAtUtc), new("نوع", item => TypeLabel(item.Type)), new("مبلغ", item => item.Amount), new("مانده پس از تراکنش", item => item.BalanceAfter), new("دسته پیام", item => item.MessageBatchId), new("مرجع", item => item.Reference) })'><PropertyColumn Property="item => item.CreatedAtUtc" Title="زمان UTC"><CellTemplate><div>@context.Item.CreatedAtUtc.ToString("yyyy/MM/dd HH:mm")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Type" Title="نوع"><CellTemplate><div><span class="transaction-type type-@((byte)context.Item.Type)">@TypeLabel(context.Item.Type)</span></div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Amount" Title="مبلغ"><CellTemplate><div class="money @(context.Item.Amount >= 0 ? "credit" : "debit")">@SignedMoney(context.Item.Amount)</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.BalanceAfter" Title="مانده پس از تراکنش"><CellTemplate><div class="money">@context.Item.BalanceAfter.ToString("N0") ریال</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.MessageBatchId" Title="دسته پیام"><CellTemplate><div class="mono">@(context.Item.MessageBatchId?.ToString() ?? "—")</div></CellTemplate></PropertyColumn>
<PropertyColumn Property="item => item.Reference" Title="مرجع"><CellTemplate><div>@(context.Item.Reference ?? "—")</div></CellTemplate></PropertyColumn></AdminGrid></div></section>
@if (_topUpOpen) { <div class="admin-drawer-backdrop" @onclick="CloseTopUp"></div><aside class="admin-editor"><header><div><h2>افزایش اعتبار</h2><p>یک ردیف بستانکار جدید به دفتر کل اضافه می‌شود.</p></div><button @onclick="CloseTopUp"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body"><label><span>مبلغ به ریال</span><input type="number" min="1" step="1" @bind="_amount" /></label><label><span>مرجع یکتا یا توضیح</span><input @bind="_reference" dir="ltr" maxlength="100" placeholder="DEV-TOPUP-001" /><small>مرجع تکراری، افزایش اعتبار را دوباره اعمال نمی‌کند.</small></label></div><footer><button class="admin-button secondary" @onclick="CloseTopUp">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="TopUp">ثبت افزایش اعتبار</button></footer></aside> }
@code {
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<CustomerItem> _customers = []; private IReadOnlyList<BalanceTransactionItem> _transactions = []; private CustomerBalanceItem? _balance; private short _customerId; private decimal _amount = 1_000_000; private string? _reference; private bool _topUpOpen; private bool _loading = true; private bool _saving; private string? _error; private string? _success;
    protected override Task OnInitializedAsync() => Load(); private async Task Load() { _loading = true; _error = null; UiResult<IReadOnlyList<CustomerItem>> result = await Customers.List(_token.Token); _customers = result.Value ?? []; _error = result.ErrorMessage; if (_customerId == 0) _customerId = _customers.FirstOrDefault(item => item.IsActive)?.Id ?? (short)0; if (_error is null && _customerId != 0) await LoadAccount(); else _loading = false; }
    private async Task LoadAccount() { _loading = true; _error = null; if (_customerId == 0) { _balance = null; _transactions = []; _loading = false; return; } Task<UiResult<CustomerBalanceItem>> balanceTask = Service.GetBalance(_customerId, _token.Token); Task<UiResult<IReadOnlyList<BalanceTransactionItem>>> transactionsTask = Service.ListTransactions(_customerId, _token.Token); await Task.WhenAll(balanceTask, transactionsTask); UiResult<CustomerBalanceItem> balance = await balanceTask; UiResult<IReadOnlyList<BalanceTransactionItem>> transactions = await transactionsTask; _balance = balance.Value; _transactions = transactions.Value ?? []; _error = balance.ErrorMessage ?? transactions.ErrorMessage; _loading = false; }
    private void OpenTopUp() { _amount = 1_000_000; _reference = $"UI-{Clock.GetUtcNow():yyyyMMddHHmmss}"; _topUpOpen = true; } private void CloseTopUp() => _topUpOpen = false;
    private async Task TopUp() { if (_amount <= 0) { _error = "مبلغ باید بزرگ‌تر از صفر باشد."; return; } _saving = true; UiResult<TopUpResponse> result = await Service.TopUp(new TopUpRequest { CustomerId = _customerId, Amount = _amount, Reference = string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim() }, _token.Token); _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _topUpOpen = false; _success = result.Value?.IsDuplicate == true ? "این مرجع قبلاً ثبت شده بود و مانده دوباره تغییر نکرد." : "اعتبار مشتری افزایش یافت."; await LoadAccount(); }
    private static string TypeLabel(BalanceTransactionType type) => type switch { BalanceTransactionType.TopUp => "افزایش اعتبار", BalanceTransactionType.Debit => "برداشت ارسال", BalanceTransactionType.Refund => "بازپرداخت", _ => "اصلاح" }; private static string SignedMoney(decimal value) => $"{(value > 0 ? "+" : string.Empty)}{value:N0} ریال"; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
