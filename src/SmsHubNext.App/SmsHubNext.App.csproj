<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>SmsHubNext.App</RootNamespace>
    <AssemblyName>SmsHubNext.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI component library for the new Persian administration experience. -->
