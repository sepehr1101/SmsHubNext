@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudText Typo="Typo.h6">سامانه مدیریت پیامک</MudText>
        </MudAppBar>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-8">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <span class="dismiss">🗙</span>
</div>
