@page "/send"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject SendingService Service
@inject SenderLinesService SenderLines
@inject MessageTypesService MessageTypes
@inject GeoSectionsService GeoSections
@inject ProvidersService Providers
@inject TimeProvider Clock
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>ارسال پیامک | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">ارسال تکی و گروهی</span><h1>ارسال پیامک</h1><p>هر گیرنده می‌تواند متن و شناسه‌های پیگیری مستقل داشته باشد.</p></div><button class="admin-button secondary" @onclick="AddMessage"><MudIcon Icon="@Icons.Material.Rounded.Add" /> افزودن گیرنده</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
@if (_sentBatchId is not null) { <div class="send-result"><MudIcon Icon="@Icons.Material.Rounded.TaskAlt" /><div><b>دسته #@_sentBatchId پذیرفته شد</b><span>@_acceptedCount پیام برای پردازش غیرهمزمان ثبت شد.</span></div><button class="admin-button primary" @onclick="OpenBatch">مشاهده دسته</button></div> }
<section class="send-config"><label><span>خط ارسال</span><select @bind="_senderLineId"><option value="0">انتخاب کنید</option>@foreach (SenderLineItem line in _lines.Where(item => item.IsActive && item.ProviderAccountId is not null)) { <option value="@line.Id">@line.LineNumber — @ProviderName(line.ProviderId)</option> }</select></label><label><span>نوع پیام</span><select @bind="_messageTypeId"><option value="0">انتخاب کنید</option>@foreach (MessageTypeItem type in _types.Where(item => item.IsActive)) { <option value="@type.Id">@type.Name</option> }</select></label><label><span>شناسه یکتای دسته</span><input @bind="_clientBatchId" dir="ltr" maxlength="100" /></label></section>
<section class="send-editor-list">
@for (int index = 0; index < _messages.Count; index++)
{
    int itemIndex = index;
    SendMessageDraft item = _messages[index];
    <article><header><b>پیام @(index + 1)</b><button disabled="@(_messages.Count == 1)" @onclick="() => RemoveMessage(itemIndex)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></header><div class="send-message-grid"><label><span>شماره گیرنده</span><input @bind="item.Recipient" dir="ltr" maxlength="12" placeholder="09121234567" /></label><label><span>منطقه جغرافیایی</span><select @bind="item.GeoSectionId"><option value="">بدون منطقه</option>@foreach (GeoSectionItem geo in _geoSections.Where(section => section.IsActive)) { <option value="@geo.Id">@GeoLabel(geo)</option> }</select></label><label class="send-text"><span>متن پیام</span><textarea @bind="item.Text" maxlength="1800" placeholder="متن مستقل این گیرنده..."></textarea><small>@item.Text.Length.ToString("N0") نویسه</small></label><details><summary>اطلاعات تکمیلی</summary><div><label><span>شناسه همبستگی</span><input @bind="item.ClientCorrelatedId" dir="ltr" maxlength="100" /></label><label><span>شناسه قبض</span><input @bind="item.BillId" dir="ltr" maxlength="31" /></label><label><span>شناسه پرداخت</span><input @bind="item.PayId" dir="ltr" maxlength="31" /></label></div></details></div></article>
}
</section>
<aside class="send-summary"><div><span>تعداد گیرنده</span><b>@_messages.Count.ToString("N0")</b></div><div><span>مجموع قطعه</span><b>@(_quotes?.Sum(item => item.SegmentCount).ToString("N0") ?? "—")</b></div><div><span>هزینه برآوردی</span><b>@(_quotes is null ? "—" : $"{_quotes.Sum(item => item.TotalCost):N0} ریال")</b></div><button class="admin-button secondary" disabled="@_quoting" @onclick="QuoteAll">استعلام هزینه</button><button class="admin-button primary" disabled="@_sending" @onclick="Send">ارسال و ثبت دسته</button></aside>

@code {
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<SenderLineItem> _lines = []; private IReadOnlyList<MessageTypeItem> _types = []; private IReadOnlyList<GeoSectionItem> _geoSections = []; private IReadOnlyList<ProviderItem> _providers = []; private readonly List<SendMessageDraft> _messages = [new()]; private List<CostQuote>? _quotes; private short _senderLineId; private byte _messageTypeId; private string _clientBatchId = string.Empty; private long? _sentBatchId; private int _acceptedCount; private bool _loading = true; private bool _quoting; private bool _sending; private string? _error; private string? _success;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; Task<ApiClientResult<IReadOnlyList<SenderLineItem>>> linesTask = SenderLines.List(_token.Token); Task<ApiClientResult<IReadOnlyList<MessageTypeItem>>> typesTask = MessageTypes.List(_token.Token); Task<ApiClientResult<IReadOnlyList<GeoSectionItem>>> geoTask = GeoSections.List(_token.Token); Task<ApiClientResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token); await Task.WhenAll(linesTask, typesTask, geoTask, providersTask); ApiClientResult<IReadOnlyList<SenderLineItem>> lines = await linesTask; ApiClientResult<IReadOnlyList<MessageTypeItem>> types = await typesTask; ApiClientResult<IReadOnlyList<GeoSectionItem>> geo = await geoTask; ApiClientResult<IReadOnlyList<ProviderItem>> providers = await providersTask; _lines = lines.Value ?? []; _types = types.Value ?? []; _geoSections = geo.Value ?? []; _providers = providers.Value ?? []; _senderLineId = _lines.FirstOrDefault(item => item.IsActive && item.ProviderAccountId is not null)?.Id ?? (short)0; _messageTypeId = _types.FirstOrDefault(item => item.IsActive)?.Id ?? (byte)0; _clientBatchId = $"ui-{Clock.GetUtcNow():yyyyMMddHHmmss}"; _error = lines.ErrorMessage ?? types.ErrorMessage ?? geo.ErrorMessage ?? providers.ErrorMessage; _loading = false; }
    private void AddMessage() { if (_messages.Count < 1000) _messages.Add(new()); _quotes = null; } private void RemoveMessage(int index) { if (_messages.Count > 1) _messages.RemoveAt(index); _quotes = null; }
    private async Task QuoteAll() { if (!Validate()) return; SenderLineItem? line = _lines.FirstOrDefault(item => item.Id == _senderLineId); if (line is null) return; _quoting = true; _error = null; List<CostQuote> quotes = []; foreach (SendMessageDraft message in _messages) { ApiClientResult<CostQuote> result = await Service.Quote(new(line.ProviderId, _messageTypeId, message.Text.Trim()), _token.Token); if (!result.IsSuccess || result.Value is null) { _error = result.ErrorMessage; _quoting = false; return; } quotes.Add(result.Value); } _quotes = quotes; _quoting = false; _success = "هزینه همه پیام‌ها با تعرفه مؤثر محاسبه شد."; }
    private async Task Send() { if (!Validate()) return; if (_quotes is null) await QuoteAll(); if (_error is not null) return; SenderLineItem line = _lines.First(item => item.Id == _senderLineId); List<SendMessageItem> messages = _messages.Select(item => new SendMessageItem(item.Recipient.Trim(), item.Text.Trim(), Clean(item.ClientCorrelatedId), Clean(item.BillId), Clean(item.PayId), item.GeoSectionId)).ToList(); _sending = true; ApiClientResult<SendMessagesResponse> result = await Service.Send(new(0, line.LineNumber, _messageTypeId, _clientBatchId.Trim(), messages), _token.Token); _sending = false; if (!result.IsSuccess || result.Value is null) { _error = result.ErrorMessage; return; } _sentBatchId = result.Value.BatchId; _acceptedCount = result.Value.AcceptedCount; _success = result.Value.IsDuplicate ? "این دسته قبلاً ثبت شده بود؛ همان نتیجه قبلی نمایش داده شد." : "دسته ارسال با موفقیت پذیرفته شد."; }
    private bool Validate() { _error = null; if (_senderLineId == 0 || _messageTypeId == 0 || string.IsNullOrWhiteSpace(_clientBatchId)) { _error = "خط ارسال، نوع پیام و شناسه دسته الزامی هستند."; return false; } if (_messages.Any(item => string.IsNullOrWhiteSpace(item.Recipient) || string.IsNullOrWhiteSpace(item.Text))) { _error = "شماره گیرنده و متن تمام پیام‌ها الزامی است."; return false; } return true; }
    private void OpenBatch() { if (_sentBatchId is not null) Navigation.NavigateTo($"/dispatch-operations/{_sentBatchId}"); } private string ProviderName(byte id) => _providers.FirstOrDefault(item => item.Id == id)?.Name ?? id.ToString(); private static string GeoLabel(GeoSectionItem item) => $"{new string('—', (int)item.SectionType - 1)} {item.Name}"; private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim(); public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
