@page "/geo-sections"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject GeoSectionsService Service
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>مناطق جغرافیایی | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">داده مرجع سلسله‌مراتبی</span><h1>مناطق جغرافیایی</h1><p>ساختار استان ← شهر ← منطقه با مسیر ثابت برای گزارش‌گیری.</p></div><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> بخش جدید</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
<section class="admin-data-panel"><header><div><h2>درخت جغرافیایی</h2><span>والد، نوع بخش و مسیر پس از ایجاد تغییر نمی‌کنند.</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>عنوان</th><th>نوع</th><th>کد</th><th>مسیر</th><th>وضعیت</th><th></th></tr></thead><tbody>
@if (!_loading && _items.Count == 0) { <tr><td colspan="6" class="admin-empty">بخش جغرافیایی ثبت نشده است.</td></tr> }
@foreach (GeoSectionItem item in OrderedItems) { <tr><td><span class="geo-name" style="padding-inline-start:@($"{Depth(item) * 20}px")"><i></i><b>@item.Name</b></span></td><td>@TypeLabel(item.SectionType)</td><td class="mono">@item.Code</td><td class="mono">@item.Path</td><td><StatusPill IsActive="item.IsActive" /></td><td class="admin-row-actions"><button @onclick="() => OpenEdit(item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" @onclick="() => Delete(item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></td></tr> }
</tbody></table></div></section>
@if (_editorOpen) { <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor"><header><div><h2>@(_editingId is null ? "بخش جغرافیایی جدید" : "ویرایش بخش")</h2><p>ترتیب مجاز: استان، شهر و سپس منطقه.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body">
@if (_editingId is null) { <label><span>نوع بخش</span><select @bind="_sectionType" @bind:after="TypeChanged"><option value="1">استان</option><option value="2">شهر</option><option value="3">منطقه</option></select></label>@if (_sectionType != GeoSectionType.Province) { <label><span>والد</span><select @bind="_parentId"><option value="">انتخاب کنید</option>@foreach (GeoSectionItem parent in ValidParents) { <option value="@parent.Id">@parent.Name — @parent.Path</option> }</select></label> } }
<label><span>عنوان</span><input @bind="_name" /></label><label><span>کد ثابت</span><input @bind="_code" dir="ltr" /></label>@if (_editingId is not null) { <label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> فعال باشد</label> }
</div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">ذخیره</button></footer></aside> }
@code {
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<GeoSectionItem> _items = []; private int? _editingId; private int? _parentId; private GeoSectionType _sectionType = GeoSectionType.Province; private string _name = string.Empty; private string _code = string.Empty; private bool _isActive = true; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success;
    private IEnumerable<GeoSectionItem> OrderedItems => _items.OrderBy(item => item.Path); private IEnumerable<GeoSectionItem> ValidParents => _items.Where(item => item.IsActive && item.SectionType == (_sectionType == GeoSectionType.City ? GeoSectionType.Province : GeoSectionType.City));
    protected override Task OnInitializedAsync() => Load(); private async Task Load() { _loading = true; _error = null; ApiClientResult<IReadOnlyList<GeoSectionItem>> result = await Service.List(_token.Token); _items = result.Value ?? []; _error = result.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _parentId = null; _sectionType = GeoSectionType.Province; _name = string.Empty; _code = string.Empty; _isActive = true; _editorOpen = true; } private void OpenEdit(GeoSectionItem item) { _editingId = item.Id; _parentId = item.ParentGeoSectionId; _sectionType = item.SectionType; _name = item.Name; _code = item.Code; _isActive = item.IsActive; _editorOpen = true; } private void CloseEditor() => _editorOpen = false; private void TypeChanged() => _parentId = null;
    private async Task Save() { if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_code) || (_sectionType != GeoSectionType.Province && _parentId is null)) { _error = "عنوان، کد و والد معتبر الزامی است."; return; } _saving = true; ApiClientResult<string?> result; if (_editingId is null) { ApiClientResult<CreateGeoSectionResponse> create = await Service.Create(new(_parentId, _sectionType, _name.Trim(), _code.Trim()), _token.Token); result = create.IsSuccess ? ApiClientResult<string?>.Success(null) : ApiClientResult<string?>.Failure(create.ErrorMessage!); } else result = await Service.Update(_editingId.Value, new(_name.Trim(), _code.Trim(), _isActive), _token.Token); _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "بخش جغرافیایی ذخیره شد."; await Load(); }
    private async Task Delete(GeoSectionItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"بخش «{item.Name}» حذف منطقی شود؟ بخش دارای فرزند قابل حذف نیست."); if (!confirmed) return; ApiClientResult<string?> result = await Service.Delete(item.Id, _token.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = $"بخش «{item.Name}» حذف شد."; await Load(); }
    private int Depth(GeoSectionItem item) => item.SectionType switch { GeoSectionType.Province => 0, GeoSectionType.City => 1, _ => 2 }; private static string TypeLabel(GeoSectionType type) => type switch { GeoSectionType.Province => "استان", GeoSectionType.City => "شهر", _ => "منطقه" }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
