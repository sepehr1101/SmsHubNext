@page "/dispatch-operations"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject DispatchOperationsService Service
@implements IDisposable

<PageTitle>پایش ارسال | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">صف عملیاتی</span><h1>پایش ارسال</h1><p>نمای زندهٔ دسته‌های در صف، نگه‌داشته‌شده و ناموفق.</p></div><div class="admin-page-actions"><label class="problem-toggle"><input type="checkbox" @bind="_onlyProblems" @bind:after="Reload" /><span>فقط موارد مشکل‌دار</span></label><button class="admin-button secondary" @onclick="Reload"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> تازه‌سازی</button></div></div>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Reload" />
@if (_summary is not null) { <section class="dispatch-kpis"><article><span>دسته‌ها</span><b>@_summary.Totals.BatchCount.ToString("N0")</b><small>@_summary.Totals.MessageCount.ToString("N0") پیام</small></article><article class="warn"><span>نگه‌داشته‌شده</span><b>@_summary.Totals.HeldBatchCount</b><small>نیازمند بررسی اعتبار</small></article><article class="danger"><span>شکست ارسال</span><b>@_summary.Totals.DispatchFailedBatchCount</b><small>بیشینه تلاش: @_summary.Totals.MaxDispatchAttemptCount</small></article><article><span>هزینه صف</span><b>@_summary.Totals.TotalCost.ToString("N0")</b><small>ریال</small></article></section> }
<section class="admin-data-panel"><header><div><h2>دسته‌های ارسال</h2><span>@(_page?.TotalCount.ToString("N0") ?? "۰") دسته مطابق فیلتر</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>شناسه</th><th>تاریخ جلالی</th><th>ارائه‌دهنده</th><th>پیام/قطعه</th><th>هزینه</th><th>وضعیت</th><th>تلاش</th><th>آخرین رویداد</th></tr></thead><tbody>
@if (!_loading && (_page?.Items.Count ?? 0) == 0) { <tr><td colspan="8" class="admin-empty">دسته‌ای مطابق فیلتر وجود ندارد.</td></tr> }
@foreach (DispatchOperationsBatchRow item in _page?.Items ?? []) { <tr><td class="mono"><a class="table-link" href="/dispatch-operations/@item.Id">#@item.Id</a></td><td class="mono">@item.SubmitDateJalali</td><td>@item.ProviderName <small class="table-sub">@item.ProviderCode</small></td><td>@item.MessageCount / @item.SegmentCount</td><td class="money">@item.TotalCost.ToString("N0") ریال</td><td><span class="batch-status status-@((byte)item.Status)">@StatusLabel(item.Status)</span>@if (item.StatusReason is not null) { <small class="table-sub">@ReasonLabel(item.StatusReason.Value)</small> }</td><td>@item.DispatchAttemptCount</td><td>@(item.LastEventType is null ? "—" : EventLabel(item.LastEventType.Value))<small class="table-sub">@(item.LastEventTimeUtc?.ToString("HH:mm") ?? string.Empty)</small></td></tr> }
</tbody></table></div>@if ((_page?.TotalCount ?? 0) > PageSize) { <footer class="admin-pagination"><button disabled="@(_currentPage <= 1)" @onclick="PreviousPage">قبلی</button><span>صفحه @_currentPage</span><button disabled="@(_page is null || _currentPage * PageSize >= _page.TotalCount)" @onclick="NextPage">بعدی</button></footer> }</section>
@code {
    private const int PageSize = 25; private readonly CancellationTokenSource _token = new(); private DispatchOperationsSummary? _summary; private DispatchOperationsBatchPage? _page; private bool _onlyProblems; private int _currentPage = 1; private bool _loading = true; private string? _error;
    protected override Task OnInitializedAsync() => Reload(); private async Task Reload() { _currentPage = 1; await Load(); } private async Task Load() { _loading = true; _error = null; Task<ApiClientResult<DispatchOperationsSummary>> summaryTask = Service.Summary(_onlyProblems, _token.Token); Task<ApiClientResult<DispatchOperationsBatchPage>> pageTask = Service.Batches(_onlyProblems, _currentPage, PageSize, _token.Token); await Task.WhenAll(summaryTask, pageTask); ApiClientResult<DispatchOperationsSummary> summary = await summaryTask; ApiClientResult<DispatchOperationsBatchPage> page = await pageTask; _summary = summary.Value; _page = page.Value; _error = summary.ErrorMessage ?? page.ErrorMessage; _loading = false; }
    private async Task PreviousPage() { if (_currentPage > 1) { _currentPage--; await Load(); } } private async Task NextPage() { if (_page is not null && _currentPage * PageSize < _page.TotalCount) { _currentPage++; await Load(); } }
    private static string StatusLabel(BatchStatus status) => status switch { BatchStatus.Received=>"دریافت‌شده",BatchStatus.Dispatching=>"در حال ارسال",BatchStatus.DispatchCompleted=>"تکمیل",BatchStatus.DispatchPartiallyFailed=>"بخشی ناموفق",BatchStatus.Held=>"نگه‌داشته",BatchStatus.Rejected=>"ردشده",_=>"شکست ارسال" }; private static string ReasonLabel(BatchStatusReason reason) => reason switch { BatchStatusReason.InsufficientProviderCredit=>"کمبود اعتبار ارائه‌دهنده",BatchStatusReason.InsufficientCustomerBalance=>"کمبود اعتبار مشتری",BatchStatusReason.DispatchRetriesExhausted=>"اتمام تلاش‌ها",BatchStatusReason.InvalidProviderCredentials=>"اعتبارنامه نامعتبر",_=>"نیازمند بررسی" }; private static string EventLabel(MessageBatchEventType type) => type switch { MessageBatchEventType.Accepted=>"پذیرش",MessageBatchEventType.DispatchStarted=>"شروع ارسال",MessageBatchEventType.Held=>"توقف",MessageBatchEventType.DispatchCompleted=>"تکمیل",MessageBatchEventType.DispatchFailed=>"شکست",MessageBatchEventType.DispatchRetryRequested=>"درخواست تلاش مجدد",_=>"به‌روزرسانی" }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
