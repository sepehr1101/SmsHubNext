@page "/dispatch-operations/{Id:long}"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject DispatchOperationsService Service
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>جزئیات دسته | SmsHub</PageTitle>
<div class="admin-page-head"><div><button class="page-back" @onclick="GoBack"><MudIcon Icon="@Icons.Material.Rounded.ArrowForward" /> بازگشت به پایش</button><h1>دسته ارسال #@Id</h1><p>جزئیات حسابداری، پیام‌ها و خط زمانی پردازش.</p></div><div class="admin-page-actions">@if (CanRetry) { <button class="admin-button primary" disabled="@_retrying" @onclick="Retry"><MudIcon Icon="@Icons.Material.Rounded.Replay" /> تلاش مجدد</button> }<button class="admin-button secondary" @onclick="Load"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> تازه‌سازی</button></div></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
@if (_success is not null) { <span class="visually-hidden">@_success</span> }
@if (_batch is not null)
{
    <section class="batch-detail-hero"><div><span>وضعیت جاری</span><b class="batch-status status-@((byte)_batch.Status)">@StatusLabel(_batch.Status)</b><small>@ReasonLabel(_batch.StatusReason)</small></div><div><span>پیام / قطعه</span><b>@_batch.MessageCount / @_batch.SegmentCount</b><small>@_batch.SubmitDateJalali</small></div><div><span>هزینه قطعی</span><b>@_batch.TotalCost.ToString("N0")</b><small>ریال</small></div><div><span>تلاش ارسال</span><b>@_batch.DispatchAttemptCount</b><small>@(_batch.NextDispatchAtUtc is null ? "بدون تلاش زمان‌بندی‌شده" : $"بعدی: {_batch.NextDispatchAtUtc:HH:mm} UTC")</small></div></section>
    <section class="batch-meta"><span><b>مشتری:</b> @_batch.CustomerId</span><span><b>ارائه‌دهنده:</b> @_batch.ProviderId</span><span><b>خط ارسال:</b> @_batch.SenderLineId</span><span><b>شناسه مشتری:</b> @(_batch.ClientBatchId ?? "—")</span><span><b>دریافت:</b> @_batch.ReceivedAtUtc.ToString("yyyy/MM/dd HH:mm:ss") UTC</span><span><b>کد ارائه‌دهنده:</b> @(_batch.ProviderResultCode?.ToString() ?? "—")</span></section>
}
<div class="batch-detail-grid"><section class="admin-data-panel"><header><div><h2>پیام‌های دسته</h2><span>@_messages.Count.ToString("N0") پیام ثبت‌شده</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>شناسه</th><th>گیرنده</th><th>ارسال</th><th>تحویل</th><th>قطعه</th><th>هزینه</th><th>همبستگی</th></tr></thead><tbody>@if (!_loading && _messages.Count == 0) { <tr><td colspan="7" class="admin-empty">پیامی در این دسته نیست.</td></tr> }@foreach (BatchMessageDetails item in _messages) { <tr><td class="mono"><a class="table-link" href="/delivery-reports?messageId=@item.Id">#@item.Id</a></td><td dir="ltr">@item.MobileNumber</td><td>@SendLabel(item.Status)</td><td><span class="delivery-state state-@((byte)item.DeliveryStatus)">@DeliveryLabel(item.DeliveryStatus)</span></td><td>@item.SegmentCount</td><td class="money">@item.TotalCost.ToString("N0")</td><td class="mono">@(item.ClientCorrelatedId ?? "—")</td></tr> }</tbody></table></div></section>
<section class="admin-data-panel"><header><div><h2>خط زمانی عملیات</h2><span>رویدادهای append-only دسته</span></div></header><div class="batch-event-timeline">@if (!_loading && _events.Count == 0) { <div class="admin-empty">رویدادی ثبت نشده است.</div> }@foreach (BatchEventDetails item in _events.OrderByDescending(item => item.EventTimeUtc)) { <article><i></i><div><strong>@EventLabel(item.EventType)</strong><p>@(item.Detail ?? "بدون توضیح")</p><small>@item.EventTimeUtc.ToString("yyyy/MM/dd HH:mm:ss") UTC @if (item.ProviderResultCode is not null) { <span>· کد @item.ProviderResultCode</span> }</small></div></article> }</div></section></div>

@code {
    [Parameter] public long Id { get; set; }
    private readonly CancellationTokenSource _token = new(); private BatchDetails? _batch; private IReadOnlyList<BatchMessageDetails> _messages = []; private IReadOnlyList<BatchEventDetails> _events = []; private bool _loading = true; private bool _retrying; private string? _error; private string? _success; private bool CanRetry => _batch?.Status == BatchStatus.DispatchFailed;
    protected override Task OnParametersSetAsync() => Load();
    private async Task Load() { _loading = true; _error = null; Task<ApiClientResult<BatchDetails>> batchTask = Service.GetBatch(Id, _token.Token); Task<ApiClientResult<IReadOnlyList<BatchMessageDetails>>> messagesTask = Service.Messages(Id, _token.Token); Task<ApiClientResult<IReadOnlyList<BatchEventDetails>>> eventsTask = Service.Events(Id, _token.Token); await Task.WhenAll(batchTask, messagesTask, eventsTask); ApiClientResult<BatchDetails> batch = await batchTask; ApiClientResult<IReadOnlyList<BatchMessageDetails>> messages = await messagesTask; ApiClientResult<IReadOnlyList<BatchEventDetails>> events = await eventsTask; _batch = batch.Value; _messages = messages.Value ?? []; _events = events.Value ?? []; _error = batch.ErrorMessage ?? messages.ErrorMessage ?? events.ErrorMessage; _loading = false; }
    private async Task Retry() { _retrying = true; _error = null; ApiClientResult<RetryDispatchResponse> result = await Service.Retry(Id, _token.Token); _retrying = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = "دسته دوباره وارد صف ارسال شد."; await Load(); }
    private void GoBack() => Navigation.NavigateTo("/dispatch-operations");
    private static string StatusLabel(BatchStatus status) => status switch { BatchStatus.Received => "دریافت‌شده", BatchStatus.Dispatching => "در حال ارسال", BatchStatus.DispatchCompleted => "تکمیل", BatchStatus.DispatchPartiallyFailed => "بخشی ناموفق", BatchStatus.Held => "نگه‌داشته", BatchStatus.Rejected => "ردشده", _ => "شکست ارسال" }; private static string ReasonLabel(BatchStatusReason? reason) => reason switch { BatchStatusReason.InsufficientProviderCredit => "کمبود اعتبار ارائه‌دهنده", BatchStatusReason.InsufficientCustomerBalance => "کمبود اعتبار مشتری", BatchStatusReason.DispatchRetriesExhausted => "پایان تلاش‌های خودکار", BatchStatusReason.InvalidProviderCredentials => "اعتبارنامه نامعتبر", BatchStatusReason.ManualReviewRequired => "نیازمند بررسی دستی", _ => "بدون دلیل خطا" }; private static string SendLabel(SendStatus status) => status switch { SendStatus.Queued => "در صف", SendStatus.Submitted => "ثبت ارائه‌دهنده", SendStatus.Sent => "ارسال‌شده", SendStatus.Rejected => "ردشده", SendStatus.AwaitingConfirmation => "انتظار تأیید", _ => "نامشخص" }; private static string DeliveryLabel(CurrentDeliveryStatus status) => status switch { CurrentDeliveryStatus.Pending => "در انتظار", CurrentDeliveryStatus.Delivered => "تحویل‌شده", CurrentDeliveryStatus.Undelivered => "تحویل‌نشده", CurrentDeliveryStatus.Expired => "منقضی", _ => "نامشخص" }; private static string EventLabel(MessageBatchEventType type) => type switch { MessageBatchEventType.Accepted => "پذیرش دسته", MessageBatchEventType.DispatchStarted => "شروع ارسال", MessageBatchEventType.DispatchResumed => "ادامه ارسال", MessageBatchEventType.Requeued => "بازگشت به صف", MessageBatchEventType.AwaitingConfirmation => "انتظار تأیید", MessageBatchEventType.Held => "توقف دسته", MessageBatchEventType.MessageRejected => "رد پیام", MessageBatchEventType.DispatchCompleted => "تکمیل ارسال", MessageBatchEventType.DispatchPartiallyFailed => "ارسال ناقص", MessageBatchEventType.DispatchFailed => "شکست ارسال", MessageBatchEventType.DeliveryUpdated => "به‌روزرسانی تحویل", _ => "درخواست تلاش مجدد" }; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
