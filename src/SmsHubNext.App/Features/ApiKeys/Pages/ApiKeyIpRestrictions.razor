@page "/api-keys/{ApiKeyId:int}/ip-restrictions"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject ApiKeysService Service
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>محدودیت IP | SmsHub</PageTitle>
<div class="admin-page-head"><div><button class="page-back" @onclick="GoBack"><MudIcon Icon="@Icons.Material.Rounded.ArrowForward" /> بازگشت به کلیدها</button><h1>محدودیت IP کلید #@ApiKeyId</h1><p>فقط آدرس‌های داخل CIDRهای زنده اجازه استفاده از این کلید را خواهند داشت.</p></div><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> افزودن محدوده</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />
<div class="admin-rule-callout"><MudIcon Icon="@Icons.Material.Rounded.Security" /><p><b>رفتار allow-list</b><span>اگر هیچ محدوده‌ای تعریف نشود، محدودیت شبکه اعمال نمی‌شود. پس از افزودن اولین CIDR فقط همان شبکه‌ها مجازند.</span></p></div>
<section class="admin-data-panel"><header><div><h2>محدوده‌های مجاز</h2><span>IPv4 و IPv6 با قالب CIDR، مانند 192.168.1.0/24</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>CIDR</th><th>توضیح</th><th></th></tr></thead><tbody>@if (!_loading && _items.Count == 0) { <tr><td colspan="3" class="admin-empty">محدودیتی تعریف نشده و کلید از همه شبکه‌ها قابل استفاده است.</td></tr> }@foreach (ApiKeyIpRestrictionItem item in _items) { <tr><td class="mono">@item.Cidr</td><td>@(item.Description ?? "—")</td><td class="admin-row-actions"><button title="ویرایش" @onclick="() => OpenEdit(item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" title="حذف" @onclick="() => Delete(item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></td></tr> }</tbody></table></div></section>
@if (_editorOpen) { <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor"><header><div><h2>@(_editingId is null ? "افزودن محدوده مجاز" : "ویرایش محدوده")</h2><p>آدرس شبکه را با prefix معتبر وارد کنید.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body"><label><span>CIDR</span><input @bind="_cidr" dir="ltr" placeholder="192.168.1.0/24" /></label><label><span>توضیح اختیاری</span><input @bind="_description" placeholder="مثلاً شبکه دفتر مرکزی" maxlength="200" /></label></div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">ذخیره</button></footer></aside> }
@code {
    [Parameter] public int ApiKeyId { get; set; }
    private readonly CancellationTokenSource _token = new(); private IReadOnlyList<ApiKeyIpRestrictionItem> _items = []; private int? _editingId; private string _cidr = string.Empty; private string? _description; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success;
    protected override Task OnParametersSetAsync() => Load(); private async Task Load() { _loading = true; _error = null; ApiClientResult<IReadOnlyList<ApiKeyIpRestrictionItem>> result = await Service.ListIpRestrictions(ApiKeyId, _token.Token); _items = result.Value ?? []; _error = result.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _cidr = string.Empty; _description = null; _editorOpen = true; } private void OpenEdit(ApiKeyIpRestrictionItem item) { _editingId = item.Id; _cidr = item.Cidr; _description = item.Description; _editorOpen = true; } private void CloseEditor() => _editorOpen = false;
    private async Task Save() { if (string.IsNullOrWhiteSpace(_cidr)) { _error = "مقدار CIDR الزامی است."; return; } _saving = true; ApiClientResult<string?> result; if (_editingId is null) { ApiClientResult<ApiKeyIpRestrictionItem> added = await Service.AddIpRestriction(ApiKeyId, new(_cidr.Trim(), Clean(_description)), _token.Token); result = added.IsSuccess ? ApiClientResult<string?>.Success(null) : ApiClientResult<string?>.Failure(added.ErrorMessage!); } else result = await Service.UpdateIpRestriction(ApiKeyId, _editingId.Value, new(_cidr.Trim(), Clean(_description)), _token.Token); _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = _editingId is null ? "محدوده مجاز افزوده شد." : "محدوده مجاز به‌روزرسانی شد."; await Load(); }
    private async Task Delete(ApiKeyIpRestrictionItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"محدوده {item.Cidr} حذف شود؟"); if (!confirmed) return; ApiClientResult<string?> result = await Service.DeleteIpRestriction(ApiKeyId, item.Id, _token.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = "محدوده حذف شد."; await Load(); }
    private void GoBack() => Navigation.NavigateTo("/api-keys"); private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim(); public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
