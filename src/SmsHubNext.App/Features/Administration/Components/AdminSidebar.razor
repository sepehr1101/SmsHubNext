@inject NavigationManager Navigation

<aside class="admin-sidebar @(_open ? "open" : null)">
    <a class="admin-logo" href="/dashboard">
        <span><MudIcon Icon="@Icons.Material.Rounded.Hub" /></span>
        <strong>SMS<span>Hub</span></strong>
    </a>

    <nav class="admin-nav" aria-label="منوی مدیریت">
        <NavLink href="/dashboard" Match="NavLinkMatch.All" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Dashboard" /> داشبورد</NavLink>

        <details class="admin-nav-group" open="@IsCurrent("operations")">
            <summary><span><MudIcon Icon="@Icons.Material.Rounded.Send" /> عملیات پیامک</span><MudIcon Icon="@Icons.Material.Rounded.ExpandMore" /></summary>
            <div><NavLink href="/send" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.AddComment" /> ارسال پیامک</NavLink><NavLink href="/dispatch-operations" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.MonitorHeart" /> پایش ارسال</NavLink><NavLink href="/reports" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Assessment" /> گزارش‌ها</NavLink><NavLink href="/inbound-messages" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.MarkEmailUnread" /> پیام‌های دریافتی</NavLink><NavLink href="/delivery-reports" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.FactCheck" /> تاریخچه تحویل</NavLink></div>
        </details>

        <details class="admin-nav-group" open="@IsCurrent("business")">
            <summary><span><MudIcon Icon="@Icons.Material.Rounded.Business" /> کسب‌وکار و مالی</span><MudIcon Icon="@Icons.Material.Rounded.ExpandMore" /></summary>
            <div><NavLink href="/customers" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.People" /> مشتریان</NavLink><NavLink href="/api-keys" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.VpnKey" /> کلیدهای API</NavLink><NavLink href="/tariffs" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.PriceChange" /> تعرفه‌ها</NavLink><NavLink href="/billing" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" /> حسابداری</NavLink></div>
        </details>

        <details class="admin-nav-group" open="@IsCurrent("infrastructure")">
            <summary><span><MudIcon Icon="@Icons.Material.Rounded.AccountTree" /> زیرساخت ارسال</span><MudIcon Icon="@Icons.Material.Rounded.ExpandMore" /></summary>
            <div><NavLink href="/providers" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Hub" /> ارائه‌دهندگان</NavLink><NavLink href="/provider-accounts" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.AdminPanelSettings" /> حساب‌های اتصال</NavLink><NavLink href="/sender-lines" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.SimCard" /> خطوط ارسال</NavLink></div>
        </details>

        <details class="admin-nav-group" open="@IsCurrent("reference")">
            <summary><span><MudIcon Icon="@Icons.Material.Rounded.Dataset" /> داده‌های مرجع</span><MudIcon Icon="@Icons.Material.Rounded.ExpandMore" /></summary>
            <div><NavLink href="/message-types" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Category" /> انواع پیام</NavLink><NavLink href="/geo-sections" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Map" /> مناطق جغرافیایی</NavLink></div>
        </details>

        <NavLink href="/settings" Match="NavLinkMatch.Prefix" @onclick="Close"><MudIcon Icon="@Icons.Material.Rounded.Settings" /> تنظیمات</NavLink>
    </nav>

    <div class="admin-sidebar-status">
        <span><i></i> محیط توسعه</span>
        <p>فیچرهای منتقل‌شده از طریق API مدیریت به داده‌های اصلی متصل می‌شوند.</p>
    </div>
</aside>

@if (_open)
{
    <button class="admin-sidebar-backdrop" aria-label="بستن منو" @onclick="Close"></button>
}

@code {
    private bool _open;

    private bool IsCurrent(string group)
    {
        string path = new Uri(Navigation.Uri).AbsolutePath;
        return group switch
        {
            "operations" => path.StartsWith("/send") || path.StartsWith("/dispatch-operations") || path.StartsWith("/reports") || path.StartsWith("/inbound-messages") || path.StartsWith("/delivery-reports"),
            "business" => path.StartsWith("/customers") || path.StartsWith("/api-keys") || path.StartsWith("/tariffs") || path.StartsWith("/billing"),
            "infrastructure" => path.StartsWith("/providers") || path.StartsWith("/provider-accounts") || path.StartsWith("/sender-lines"),
            "reference" => path.StartsWith("/message-types") || path.StartsWith("/geo-sections"),
            _ => false,
        };
    }

    public void Toggle()
    {
        _open = !_open;
    }

    private void Close()
    {
        _open = false;
    }
}
