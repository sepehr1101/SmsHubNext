@page "/settings"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject ProvidersService Providers
@inject ProviderAccountsService ProviderAccounts
@inject SenderLinesService SenderLines
@inject TariffsService Tariffs
@inject CustomersService Customers
@inject ApiKeysService ApiKeys
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>تنظیمات | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">مرکز پیکربندی سامانه</span><h1>تنظیمات</h1><p>وضعیت واقعی اتصال‌ها، ارسال و امنیت؛ متصل به API مدیریت.</p></div><button class="admin-button secondary" @onclick="Load"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> تازه‌سازی وضعیت</button></div>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Load" />
<div class="admin-settings-layout">
<nav class="admin-settings-nav"><button class="@ActiveClass("general")" @onclick='() => SelectSection("general")'><MudIcon Icon="@Icons.Material.Rounded.Tune" /><span><b>عمومی</b><small>تصمیم‌های ثابت سامانه</small></span></button><button class="@ActiveClass("providers")" @onclick='() => SelectSection("providers")'><MudIcon Icon="@Icons.Material.Rounded.Hub" /><span><b>ارائه‌دهندگان</b><small>@_accounts.Count حساب اتصال</small></span></button><button class="@ActiveClass("sending")" @onclick='() => SelectSection("sending")'><MudIcon Icon="@Icons.Material.Rounded.Send" /><span><b>ارسال و تعرفه</b><small>@_lines.Count خط · @_tariffs.Count تعرفه</small></span></button><button class="@ActiveClass("security")" @onclick='() => SelectSection("security")'><MudIcon Icon="@Icons.Material.Rounded.Security" /><span><b>امنیت و API</b><small>@_apiKeyCount کلید</small></span></button></nav>
<div class="admin-settings-content">
@if (_activeSection == "general")
{
<SettingsSection Title="تنظیمات عمومی" Description="تصمیم‌های معماری ثابت این نسخه" Icon="@Icons.Material.Rounded.Tune"><div class="settings-facts"><article><span>نام سامانه</span><b>SmsHubNext</b><small>نام میزبان برنامه</small></article><article><span>واحد پول</span><b>ریال ایران</b><small>IRR · DECIMAL(19,4)</small></article><article><span>تقویم گزارش</span><b>جلالی</b><small>کلید دوره yyyy/MM/dd</small></article><article><span>زمان دقیق</span><b>UTC</b><small>timestampهای دیتابیس</small></article></div><div class="settings-backend-note"><MudIcon Icon="@Icons.Material.Rounded.Info" /><div><b>این موارد قابل تغییر نیستند</b><span>واحد پول، تقویم گزارش و ذخیره زمان تصمیم‌های قفل‌شده معماری‌اند. تنظیم عمومی قابل ویرایش ابتدا به مدل و API backend نیاز دارد.</span></div></div></SettingsSection>
}
else if (_activeSection == "providers")
{
<SettingsSection Title="ارائه‌دهندگان و اتصال‌ها" Description="وضعیت واقعی Provider و ProviderAccount" Icon="@Icons.Material.Rounded.Hub"><div class="settings-summary"><article><b>@_providers.Count(item => item.IsActive)</b><span>ارائه‌دهنده فعال</span></article><article><b>@_accounts.Count(item => item.IsActive)</b><span>حساب اتصال فعال</span></article><article><b>@_accounts.Count(item => item.HasSecret)</b><span>راز پیکربندی‌شده</span></article></div><div class="settings-provider-list">@foreach (ProviderItem provider in _providers) { IReadOnlyList<ProviderAccountItem> accounts = _accounts.Where(item => item.ProviderId == provider.Id).ToList(); bool ready = accounts.Any(item => item.IsActive && item.HasSecret); <article><div class="admin-provider-logo">@provider.Name[..1]</div><div><b>@provider.Name</b><small>@provider.Code · @accounts.Count حساب اتصال</small></div><StatusPill IsActive="provider.IsActive" /><span class="settings-health @(ready ? "ready" : "missing")">@(ready ? "آماده اتصال" : "نیازمند حساب معتبر")</span></article> }</div><div class="settings-actions"><a class="admin-button secondary" href="/providers">ارائه‌دهندگان</a><a class="admin-button primary" href="/provider-accounts">حساب‌های اتصال</a></div></SettingsSection>
}
else if (_activeSection == "sending")
{
<SettingsSection Title="ارسال و قیمت‌گذاری" Description="وضعیت خطوط و تعرفه‌های عملیاتی" Icon="@Icons.Material.Rounded.Send"><div class="settings-summary"><article><b>@_lines.Count(item => item.IsActive)</b><span>خط فعال</span></article><article><b>@_lines.Count(item => item.IsActive && item.ProviderAccountId is not null)</b><span>خط آماده ارسال</span></article><article><b>@_tariffs.Count(item => item.IsActive)</b><span>تعرفه فعال</span></article></div><div class="settings-readiness"><div><i class="@ReadyClass(_lines.Any(item => item.IsActive && item.ProviderAccountId is not null))"></i><p><b>خط متصل به حساب ارائه‌دهنده</b><small>@(_lines.Any(item => item.IsActive && item.ProviderAccountId is not null) ? "حداقل یک خط آماده ارسال واقعی است." : "هیچ خط فعالی به حساب اتصال متصل نیست.")</small></p><a href="/sender-lines">مدیریت</a></div><div><i class="@ReadyClass(_tariffs.Any(item => item.IsActive))"></i><p><b>تعرفه مؤثر</b><small>@(_tariffs.Any(item => item.IsActive) ? "تعرفه فعال برای قیمت‌گذاری وجود دارد." : "ارسال بدون تعرفه مؤثر پذیرفته نمی‌شود.")</small></p><a href="/tariffs">مدیریت</a></div><div><i class="ready"></i><p><b>Snapshot هزینه</b><small>هزینه هنگام پذیرش محاسبه و روی پیام ثابت می‌شود.</small></p><span>قفل معماری</span></div></div><div class="settings-actions"><a class="admin-button secondary" href="/sender-lines">خطوط ارسال</a><a class="admin-button secondary" href="/tariffs">تعرفه‌ها</a><a class="admin-button primary" href="/send">ارسال آزمایشی</a></div></SettingsSection>
}
else
{
<SettingsSection Title="امنیت و API" Description="کلیدها، نشست مدیریت و محدودیت شبکه" Icon="@Icons.Material.Rounded.Security"><div class="settings-summary"><article><b>@_customers.Count(item => item.IsActive)</b><span>مشتری فعال</span></article><article><b>@_apiKeyCount</b><span>کلید API</span></article><article><b>۱۵</b><span>دقیقه اعتبار JWT</span></article></div><div class="admin-security-cards"><article><i><MudIcon Icon="@Icons.Material.Rounded.VpnKey" /></i><div><b>کلیدهای API</b><small>راز فقط هنگام صدور نمایش داده می‌شود و SHA-256 آن ذخیره می‌گردد.</small></div><a href="/api-keys">مدیریت کلیدها</a></article><article><i><MudIcon Icon="@Icons.Material.Rounded.Lan" /></i><div><b>محدودیت CIDR</b><small>allow-list شبکه از صفحه هر کلید قابل مدیریت است.</small></div><a href="/api-keys">انتخاب کلید</a></article><article><i><MudIcon Icon="@Icons.Material.Rounded.Timer" /></i><div><b>توکن مدیریت</b><small>JWT کوتاه‌عمر با نقش Administrator استفاده می‌شود.</small></div><span class="admin-status-chip online">فعال</span></article></div><form method="post" action="/auth/logout" data-enhance="false" class="admin-logout-form"><AntiforgeryToken /><button class="admin-button danger" type="submit"><MudIcon Icon="@Icons.Material.Rounded.Logout" /> خروج از حساب آزمایشی</button></form></SettingsSection>
}
</div></div>

@code {
private readonly CancellationTokenSource _token = new(); private string _activeSection = "general"; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<ProviderAccountItem> _accounts = []; private IReadOnlyList<SenderLineItem> _lines = []; private IReadOnlyList<TariffItem> _tariffs = []; private IReadOnlyList<CustomerItem> _customers = []; private int _apiKeyCount; private bool _loading = true; private string? _error;
protected override Task OnInitializedAsync() => Load();
private async Task Load() { _loading = true; _error = null; Task<ApiClientResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_token.Token); Task<ApiClientResult<IReadOnlyList<ProviderAccountItem>>> accountsTask = ProviderAccounts.List(_token.Token); Task<ApiClientResult<IReadOnlyList<SenderLineItem>>> linesTask = SenderLines.List(_token.Token); Task<ApiClientResult<IReadOnlyList<TariffItem>>> tariffsTask = Tariffs.List(_token.Token); Task<ApiClientResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_token.Token); await Task.WhenAll(providersTask, accountsTask, linesTask, tariffsTask, customersTask); ApiClientResult<IReadOnlyList<ProviderItem>> providers = await providersTask; ApiClientResult<IReadOnlyList<ProviderAccountItem>> accounts = await accountsTask; ApiClientResult<IReadOnlyList<SenderLineItem>> lines = await linesTask; ApiClientResult<IReadOnlyList<TariffItem>> tariffs = await tariffsTask; ApiClientResult<IReadOnlyList<CustomerItem>> customers = await customersTask; _providers = providers.Value ?? []; _accounts = accounts.Value ?? []; _lines = lines.Value ?? []; _tariffs = tariffs.Value ?? []; _customers = customers.Value ?? []; _error = providers.ErrorMessage ?? accounts.ErrorMessage ?? lines.ErrorMessage ?? tariffs.ErrorMessage ?? customers.ErrorMessage; _apiKeyCount = 0; if (_error is null) { foreach (CustomerItem customer in _customers) { ApiClientResult<IReadOnlyList<ApiKeyItem>> keys = await ApiKeys.List(customer.Id, _token.Token); if (!keys.IsSuccess) { _error = keys.ErrorMessage; break; } _apiKeyCount += keys.Value?.Count ?? 0; } } _loading = false; }
private string? ActiveClass(string section) => _activeSection == section ? "active" : null; private void SelectSection(string section) => _activeSection = section; private static string ReadyClass(bool ready) => ready ? "ready" : "missing"; public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
