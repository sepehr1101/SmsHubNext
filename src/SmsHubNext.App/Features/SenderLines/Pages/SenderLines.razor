@page "/sender-lines"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject SenderLinesService Service
@inject ProvidersService Providers
@inject ProviderAccountsService Accounts
@inject CustomersService Customers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>خطوط ارسال | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">مسیر ارسال</span><h1>خطوط ارسال</h1><p>مدیریت شماره‌های فرستنده، مالکیت مشتری و حساب ارائه‌دهنده.</p></div><button class="admin-button primary" @onclick="OpenCreate"><MudIcon Icon="@Icons.Material.Rounded.Add" /> خط ارسال جدید</button></div>
<FeatureNotice Loading="_loading" Error="@_error" Success="@_success" OnRetry="Load" />

<section class="admin-data-panel"><header><div><h2>شماره‌های فرستنده</h2><span>خط اشتراکی مالک مشتری ندارد؛ خط اختصاصی می‌تواند به یک مشتری تعلق بگیرد.</span></div><div class="admin-table-search"><MudIcon Icon="@Icons.Material.Rounded.Search" /><input @bind="_filter" placeholder="جست‌وجوی شماره…" dir="ltr" /></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>خط</th><th>ارائه‌دهنده</th><th>نوع مالکیت</th><th>مشتری</th><th>حساب اتصال</th><th>وضعیت</th><th></th></tr></thead><tbody>
    @if (!_loading && FilteredItems.Count == 0) { <tr><td colspan="7" class="admin-empty">خط ارسالی ثبت نشده است.</td></tr> }
    @foreach (SenderLineItem item in FilteredItems)
    {
        <tr><td class="mono"><b>@item.LineNumber</b></td><td>@ProviderName(item.ProviderId)</td><td><span class="admin-line-kind @(item.IsSharedLine ? "shared" : "dedicated")">@(item.IsSharedLine ? "اشتراکی" : "اختصاصی")</span></td><td>@CustomerName(item.CustomerId)</td><td>@AccountName(item.ProviderAccountId)</td><td><StatusPill IsActive="item.IsActive" /></td><td class="admin-row-actions"><button title="ویرایش" @onclick="() => OpenEdit(item)"><MudIcon Icon="@Icons.Material.Rounded.Edit" /></button><button class="danger" title="حذف منطقی" @onclick="() => Delete(item)"><MudIcon Icon="@Icons.Material.Rounded.DeleteOutline" /></button></td></tr>
    }
</tbody></table></div></section>

@if (_editorOpen)
{
    <div class="admin-drawer-backdrop" @onclick="CloseEditor"></div><aside class="admin-editor"><header><div><h2>@(_editingId is null ? "خط ارسال جدید" : "ویرایش خط ارسال")</h2><p>ارائه‌دهنده خط پس از ایجاد قابل تغییر نیست.</p></div><button @onclick="CloseEditor"><MudIcon Icon="@Icons.Material.Rounded.Close" /></button></header><div class="admin-editor-body">
        <label><span>ارائه‌دهنده</span><select @bind="_providerId" disabled="@(_editingId is not null)"><option value="0">انتخاب کنید</option>@foreach (ProviderItem provider in _providers.Where(item => item.IsActive)) { <option value="@provider.Id">@provider.Name</option> }</select></label>
        <label><span>شماره خط</span><input @bind="_lineNumber" dir="ltr" placeholder="30001234" /></label>
        <label class="admin-checkbox"><input type="checkbox" @bind="_isSharedLine" @bind:after="SharedLineChanged" /> خط بین مشتریان مشترک است</label>
        @if (!_isSharedLine)
        {
            <label><span>مشتری مالک (اختیاری)</span><select @bind="_customerId"><option value="">بدون مالک</option>@foreach (CustomerItem customer in _customers.Where(item => item.IsActive)) { <option value="@customer.Id">@customer.Name</option> }</select></label>
        }
        <label><span>حساب ارائه‌دهنده (اختیاری)</span><select @bind="_providerAccountId"><option value="">بدون حساب</option>@foreach (ProviderAccountItem account in MatchingAccounts) { <option value="@account.Id">@account.DisplayName</option> }</select><small>فقط حساب‌های فعال همان ارائه‌دهنده نمایش داده می‌شوند.</small></label>
        <label class="admin-checkbox"><input type="checkbox" @bind="_isActive" /> خط فعال باشد</label>
    </div><footer><button class="admin-button secondary" @onclick="CloseEditor">انصراف</button><button class="admin-button primary" disabled="@_saving" @onclick="Save">@(_saving ? "در حال ذخیره…" : "ذخیره")</button></footer></aside>
}

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private IReadOnlyList<SenderLineItem> _items = []; private IReadOnlyList<ProviderItem> _providers = []; private IReadOnlyList<ProviderAccountItem> _accounts = []; private IReadOnlyList<CustomerItem> _customers = []; private short? _editingId; private byte _providerId; private string _lineNumber = string.Empty; private bool _isSharedLine = true; private short? _customerId; private int? _providerAccountId; private bool _isActive = true; private string _filter = string.Empty; private bool _loading = true; private bool _saving; private bool _editorOpen; private string? _error; private string? _success;
    private IReadOnlyList<SenderLineItem> FilteredItems => string.IsNullOrWhiteSpace(_filter) ? _items : _items.Where(item => item.LineNumber.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private IEnumerable<ProviderAccountItem> MatchingAccounts => _accounts.Where(item => item.ProviderId == _providerId && item.IsActive);
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; Task<ApiClientResult<IReadOnlyList<SenderLineItem>>> linesTask = Service.List(_disposeToken.Token); Task<ApiClientResult<IReadOnlyList<ProviderItem>>> providersTask = Providers.List(_disposeToken.Token); Task<ApiClientResult<IReadOnlyList<ProviderAccountItem>>> accountsTask = Accounts.List(_disposeToken.Token); Task<ApiClientResult<IReadOnlyList<CustomerItem>>> customersTask = Customers.List(_disposeToken.Token); await Task.WhenAll(linesTask, providersTask, accountsTask, customersTask); ApiClientResult<IReadOnlyList<SenderLineItem>> lines = await linesTask; ApiClientResult<IReadOnlyList<ProviderItem>> providers = await providersTask; ApiClientResult<IReadOnlyList<ProviderAccountItem>> accounts = await accountsTask; ApiClientResult<IReadOnlyList<CustomerItem>> customers = await customersTask; _items = lines.Value ?? []; _providers = providers.Value ?? []; _accounts = accounts.Value ?? []; _customers = customers.Value ?? []; _error = lines.ErrorMessage ?? providers.ErrorMessage ?? accounts.ErrorMessage ?? customers.ErrorMessage; _loading = false; }
    private void OpenCreate() { _editingId = null; _providerId = 0; _lineNumber = string.Empty; _isSharedLine = true; _customerId = null; _providerAccountId = null; _isActive = true; _editorOpen = true; }
    private void OpenEdit(SenderLineItem item) { _editingId = item.Id; _providerId = item.ProviderId; _lineNumber = item.LineNumber; _isSharedLine = item.IsSharedLine; _customerId = item.CustomerId; _providerAccountId = item.ProviderAccountId; _isActive = item.IsActive; _editorOpen = true; }
    private void SharedLineChanged() { if (_isSharedLine) _customerId = null; }
    private void CloseEditor() => _editorOpen = false;
    private async Task Save() { if (_providerId == 0 || string.IsNullOrWhiteSpace(_lineNumber)) { _error = "ارائه‌دهنده و شماره خط الزامی است."; return; } if (_isSharedLine) _customerId = null; _saving = true; ApiClientResult<string?> result; if (_editingId is null) { ApiClientResult<CreateSenderLineResponse> create = await Service.Create(new(_providerId, _lineNumber.Trim(), _isSharedLine, _customerId, _providerAccountId, _isActive), _disposeToken.Token); result = create.IsSuccess ? ApiClientResult<string?>.Success(null) : ApiClientResult<string?>.Failure(create.ErrorMessage!); } else { result = await Service.Update(_editingId.Value, new(_lineNumber.Trim(), _isSharedLine, _customerId, _providerAccountId, _isActive), _disposeToken.Token); } _saving = false; if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _editorOpen = false; _success = "خط ارسال ذخیره شد."; await Load(); }
    private async Task Delete(SenderLineItem item) { bool confirmed = await JS.InvokeAsync<bool>("confirm", $"خط «{item.LineNumber}» حذف منطقی شود؟"); if (!confirmed) return; ApiClientResult<string?> result = await Service.Delete(item.Id, _disposeToken.Token); if (!result.IsSuccess) { _error = result.ErrorMessage; return; } _success = $"خط «{item.LineNumber}» حذف منطقی شد."; await Load(); }
    private string ProviderName(byte id) => _providers.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}";
    private string CustomerName(short? id) => id is null ? "—" : _customers.FirstOrDefault(item => item.Id == id)?.Name ?? $"#{id}";
    private string AccountName(int? id) => id is null ? "—" : _accounts.FirstOrDefault(item => item.Id == id)?.DisplayName ?? $"#{id}";
    public void Dispose() { _disposeToken.Cancel(); _disposeToken.Dispose(); }
}
