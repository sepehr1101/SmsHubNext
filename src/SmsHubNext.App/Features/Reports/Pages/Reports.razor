@page "/reports"
@layout AdminLayout
@attribute [Authorize(Roles = DevelopmentAccount.AdministratorRole)]
@inject ReportsService Service
@implements IDisposable

<PageTitle>گزارش پیام‌ها | SmsHub</PageTitle>
<div class="admin-page-head"><div><span class="admin-kicker">تحلیل عملکرد</span><h1>گزارش پیام‌ها</h1><p>هزینه، نرخ تحویل و تعداد پیام‌ها بر اساس داده‌های قطعی ثبت‌شده.</p></div><button class="admin-button secondary" @onclick="Load"><MudIcon Icon="@Icons.Material.Rounded.Refresh" /> به‌روزرسانی</button></div>
<section class="report-filters"><label><span>از تاریخ جلالی</span><input @bind="_from" dir="ltr" placeholder="1405/07/01" /></label><label><span>تا تاریخ جلالی</span><input @bind="_to" dir="ltr" placeholder="1405/07/30" /></label><button class="admin-button primary" @onclick="Load">اعمال بازه</button></section>
<FeatureNotice Loading="_loading" Error="@_error" OnRetry="Load" />
@if (_summary is not null)
{
    <section class="dispatch-kpis"><article><span>کل پیام‌ها</span><b>@_summary.Totals.MessageCount.ToString("N0")</b><small>@_summary.Totals.SegmentCount.ToString("N0") قطعه</small></article><article><span>تحویل‌شده</span><b>@_summary.Totals.DeliveredCount.ToString("N0")</b><small>@_summary.Totals.DeliveryRate.ToString("N1")٪ نرخ تحویل</small></article><article class="danger"><span>تحویل‌نشده</span><b>@_summary.Totals.UndeliveredCount.ToString("N0")</b><small>@_summary.Totals.ExpiredCount.ToString("N0") منقضی</small></article><article><span>هزینه کل</span><b>@_summary.Totals.TotalCost.ToString("N0")</b><small>ریال</small></article></section>
}
<div class="report-grid"><section class="admin-data-panel"><header><div><h2>بر اساس ارائه‌دهنده</h2><span>مقایسه مسیرهای ارسال</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ارائه‌دهنده</th><th>پیام</th><th>هزینه</th><th>نرخ تحویل</th></tr></thead><tbody>@if (!_loading && _providers.Count == 0) { <tr><td colspan="4" class="admin-empty">داده‌ای در این بازه نیست.</td></tr> }@foreach (ProviderMessageReportRow row in _providers) { <tr><td>@row.ProviderName<small class="table-sub">@row.ProviderCode</small></td><td>@row.Stats.MessageCount.ToString("N0")</td><td class="money">@row.Stats.TotalCost.ToString("N0")</td><td><span class="report-rate">@row.Stats.DeliveryRate.ToString("N1")٪</span></td></tr> }</tbody></table></div></section>
<section class="admin-data-panel"><header><div><h2>بر اساس نوع پیام</h2><span>تفکیک کاربرد پیام</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>نوع پیام</th><th>پیام</th><th>قطعه</th><th>هزینه</th></tr></thead><tbody>@if (!_loading && _types.Count == 0) { <tr><td colspan="4" class="admin-empty">داده‌ای در این بازه نیست.</td></tr> }@foreach (MessageTypeReportRow row in _types) { <tr><td>@row.MessageTypeName<small class="table-sub">@row.MessageTypeCode</small></td><td>@row.Stats.MessageCount.ToString("N0")</td><td>@row.Stats.SegmentCount.ToString("N0")</td><td class="money">@row.Stats.TotalCost.ToString("N0")</td></tr> }</tbody></table></div></section></div>
<section class="admin-data-panel"><header><div><h2>روند ماهانه جلالی</h2><span>مبنای گزارش همان کلید دوره ذخیره‌شده روی پیام است.</span></div></header><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ماه</th><th>پیام</th><th>تحویل‌شده</th><th>تحویل‌نشده</th><th>نرخ تحویل</th><th>هزینه</th></tr></thead><tbody>@foreach (JalaliMonthMessageReportRow row in _months) { <tr><td class="mono">@row.JalaliMonth</td><td>@row.Stats.MessageCount.ToString("N0")</td><td>@row.Stats.DeliveredCount.ToString("N0")</td><td>@row.Stats.UndeliveredCount.ToString("N0")</td><td>@row.Stats.DeliveryRate.ToString("N1")٪</td><td class="money">@row.Stats.TotalCost.ToString("N0") ریال</td></tr> }</tbody></table></div></section>

@code {
    private readonly CancellationTokenSource _token = new(); private string _from = "1405/07/01"; private string _to = "1405/07/30"; private MessageReportSummary? _summary; private IReadOnlyList<ProviderMessageReportRow> _providers = []; private IReadOnlyList<MessageTypeReportRow> _types = []; private IReadOnlyList<JalaliMonthMessageReportRow> _months = []; private bool _loading = true; private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { _loading = true; _error = null; string query = $"fromJalali={Uri.EscapeDataString(_from.Trim())}&toJalali={Uri.EscapeDataString(_to.Trim())}"; Task<ApiClientResult<MessageReportSummary>> summaryTask = Service.Summary(query, _token.Token); Task<ApiClientResult<IReadOnlyList<ProviderMessageReportRow>>> providersTask = Service.ByProvider(query, _token.Token); Task<ApiClientResult<IReadOnlyList<MessageTypeReportRow>>> typesTask = Service.ByMessageType(query, _token.Token); Task<ApiClientResult<IReadOnlyList<JalaliMonthMessageReportRow>>> monthsTask = Service.ByMonth(query, _token.Token); await Task.WhenAll(summaryTask, providersTask, typesTask, monthsTask); ApiClientResult<MessageReportSummary> summary = await summaryTask; ApiClientResult<IReadOnlyList<ProviderMessageReportRow>> providers = await providersTask; ApiClientResult<IReadOnlyList<MessageTypeReportRow>> types = await typesTask; ApiClientResult<IReadOnlyList<JalaliMonthMessageReportRow>> months = await monthsTask; _summary = summary.Value; _providers = providers.Value ?? []; _types = types.Value ?? []; _months = months.Value ?? []; _error = summary.ErrorMessage ?? providers.ErrorMessage ?? types.ErrorMessage ?? months.ErrorMessage; _loading = false; }
    public void Dispose() { _token.Cancel(); _token.Dispose(); }
}
