@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject IWebHostEnvironment Environment

<PageTitle>ورود به پنل | SmsHub</PageTitle>

<section class="login-page">
    <div class="login-form-side">
        <a class="login-brand" href="/" aria-label="صفحه اصلی SmsHub">
            <span class="login-brand-mark"><MudIcon Icon="@Icons.Material.Rounded.Hub" /></span>
            <span>SMS<span>Hub</span></span>
        </a>

        <div class="login-card">
            <div class="login-heading">
                <span class="login-eyebrow">خوش آمدید</span>
                <h1>ورود به پنل مدیریت</h1>
                <p>برای مشاهده و مدیریت سامانه وارد حساب آزمایشی شوید.</p>
            </div>

            @if (Error == "invalid_credentials")
            {
                <div class="login-alert" role="alert">
                    <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" />
                    نام کاربری یا رمز عبور درست نیست.
                </div>
            }

            @if (Environment.IsDevelopment())
            {
                <div class="login-demo-note">
                    <MudIcon Icon="@Icons.Material.Rounded.Science" />
                    <span>حساب آزمایشی: <b>Admin</b> / <b>123456</b></span>
                </div>
            }

            <form class="login-form" method="post" action="/auth/login" data-enhance="false">
                <AntiforgeryToken />
                <label for="username">نام کاربری</label>
                <div class="login-input-wrap">
                    <MudIcon Icon="@Icons.Material.Rounded.PersonOutline" />
                    <input id="username" name="username" type="text" value="Admin" autocomplete="username" required autofocus />
                </div>

                <label for="password">رمز عبور</label>
                <div class="login-input-wrap">
                    <MudIcon Icon="@Icons.Material.Rounded.Lock" />
                    <input id="password" name="password" type="@(_showPassword ? "text" : "password")" value="123456" autocomplete="current-password" required />
                    <button class="login-password-toggle" type="button" aria-label="نمایش یا مخفی کردن رمز عبور" @onclick="TogglePassword">
                        <MudIcon Icon="@(_showPassword ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)" />
                    </button>
                </div>

                <label class="login-remember">
                    <input name="remember" type="checkbox" />
                    <span>ورود من را به خاطر بسپار</span>
                </label>

                <button class="login-submit" type="submit">
                    ورود به پنل
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" />
                </button>
            </form>

            <a class="login-back" href="/">
                <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" />
                بازگشت به صفحه اصلی
            </a>
        </div>
    </div>

    <aside class="login-visual" aria-label="شبکه یکپارچه ارائه‌دهندگان پیامک">
        <div class="login-glow login-glow-one"></div>
        <div class="login-glow login-glow-two"></div>
        <div class="login-orbit login-orbit-one"></div>
        <div class="login-orbit login-orbit-two"></div>
        <div class="login-orbit login-orbit-three"></div>
        <div class="login-core">
            <span><MudIcon Icon="@Icons.Material.Rounded.Hub" /></span>
            <b>SMSHub</b>
            <small>مرکز یکپارچه پیامک</small>
        </div>
        <div class="login-provider login-provider-magfa"><i></i><span>مگفا</span></div>
        <div class="login-provider login-provider-one"><i></i><span>3000</span></div>
        <div class="login-provider login-provider-two"><i></i><span>1000</span></div>
        <div class="login-provider login-provider-three"><i></i><span>4040</span></div>
        <div class="login-visual-copy">
            <strong>همه‌چیز، در یک پنل</strong>
            <span>ارسال، حسابداری و گزارش‌گیری پیامک‌های سازمانی</span>
        </div>
    </aside>
</section>

@code {
    private bool _showPassword;

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }
}
